+        void SaveState(State &out) const noexcept
+        {
+            out.pageBase = m_pageBase;
+            out.pending = m_pending ? 1u : 0u;
+            std::memcpy(out.bytes, m_bytes.data(), kPageSize);
+        }
+        void LoadState(const State &in) noexcept
+        {
+            m_pageBase = in.pageBase;
+            m_pending = in.pending != 0u;
+            std::memcpy(m_bytes.data(), in.bytes, kPageSize);
+        }
+
+    private:
+        alignas(64) std::array<uint8_t, kPageSize> m_bytes{};
+        uint32_t m_pageBase = UINT32_MAX;
+        bool m_pending = false;
+    };
+}
