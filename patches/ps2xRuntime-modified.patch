+            case 0xBEu: // padding_stream
+            case 0xBFu: // private_stream_2
+            case 0xF0u: // ECM
+            case 0xF1u: // EMM
+            case 0xF2u: // DSMCC
+            case 0xF8u: // ITU-T H.222.1 type E
