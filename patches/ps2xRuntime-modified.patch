+{
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+
+    Image image = LoadImageFromTexture(frame);
+    ImageCrop(&image, Rectangle{0.0f, 0.0f, static_cast<float>(visibleWidth), static_cast<float>(visibleHeight)});
+    const std::filesystem::path path = std::filesystem::path(dir) / (name + ".png");
+    const bool ok = ExportImage(image, path.string().c_str());
+    UnloadImage(image);
+    std::cout << "[shot] " << (ok ? "saved " : "FAILED ") << path.string() << std::endl;
+}
