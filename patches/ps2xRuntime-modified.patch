+                MpegDecodedFrame decoded;
+                decoded.width = width;
+                decoded.height = height;
+                decoded.repeatPict = std::max(0, m_frame->repeat_pict);
+                decoded.pts90k = m_frame->best_effort_timestamp != AV_NOPTS_VALUE
