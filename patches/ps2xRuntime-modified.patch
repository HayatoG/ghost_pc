+void GSCpuBackend::PreparePixelSetup(const GSDrawState &state, PixelSetup &ps) const
+{
+    const auto &ctx = state.context;
+    ps.scissorX0 = ctx.scissor.x0;
+    ps.scissorX1 = ctx.scissor.x1;
+    ps.scissorY0 = ctx.scissor.y0;
+    ps.scissorY1 = ctx.scissor.y1;
+
+    ps.fge = state.prim.fge != 0;
+    ps.fogR = state.fogR;
+    ps.fogG = state.fogG;
+    ps.fogB = state.fogB;
+
+    ps.fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    ps.fbw = std::max<u32>(ctx.frame.fbw, 1u);
+    ps.fpsm = ctx.frame.psm;
+    ps.zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    ps.zpsm = ctx.zbuf.psm;
+    ps.readFrame = m_readVramFuncs[ps.fpsm & 0x3Fu];
+    ps.readDepth = m_readVramFuncs[ps.zpsm & 0x3Fu];
+    ps.writeFrame = m_writeVramFuncs[ps.fpsm & 0x3Fu];
+    ps.writeDepth = m_writeVramFuncs[ps.zpsm & 0x3Fu];
+    ps.pageTableC32 = &GSMem::GetPageTableC32();
+
+    const uint64_t test = ctx.test;
+    ps.alphaTestEnabled = (test & 0x1u) != 0u;
+    ps.alphaTestMethod = static_cast<uint8_t>((test >> 1) & 0x7u);
+    ps.alphaRef = static_cast<uint8_t>((test >> 4) & 0xFFu);
+    switch (static_cast<uint8_t>((test >> 12) & 0x3u))
+    {
+    case 1:
+        ps.alphaFailMask = {true, true, false};
+        break;
+    case 2:
+        ps.alphaFailMask = {false, false, true};
+        break;
+    case 3:
+        if (ps.fpsm == GS_PSM_CT32)
+            ps.alphaFailMask = {true, false, false};
+        else
+            ps.alphaFailMask = {true, true, false};
+        break;
+    case 0:
+    default:
+        ps.alphaFailMask = {false, false, false};
+        break;
+    }
+    ps.ztestMethod = static_cast<uint32_t>((test >> 17) & 3u);
+    ps.destinationAlphaTest = ((test >> 14) & 0x1u) != 0u;
+    ps.destinationAlphaMode = ((test >> 15) & 0x1u) != 0u;
+    switch (ps.fpsm)
+    {
+    case GS_PSM_CT32:
+        ps.destinationAlphaBit = 31u;
+        break;
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+        ps.destinationAlphaBit = 15u;
+        break;
+    default:
+        ps.destinationAlphaBit = 0u;
+        break;
+    }
+    ps.destinationAlphaTestNeedsRead = ps.destinationAlphaTest &&
+                                       (ps.fpsm == GS_PSM_CT32 || ps.fpsm == GS_PSM_CT16 || ps.fpsm == GS_PSM_CT16S);
+
+    ps.alphaBlendEnabled = state.prim.abe != 0;
+    ps.pabe = state.pabe;
+    const uint64_t alphaReg = ctx.alpha;
+    ps.asel = alphaReg & 3;
+    ps.bsel = (alphaReg >> 2) & 3;
+    ps.csel = (alphaReg >> 4) & 3;
+    ps.dsel = (alphaReg >> 6) & 3;
+    ps.fix = static_cast<uint8_t>((alphaReg >> 32) & 0xFF);
+
+    ps.fbmsk = ctx.frame.fbmsk;
+    ps.frame16 = bitsPerPixel(static_cast<uint8_t>(ps.fpsm)) == 16;
+    ps.frameCT24 = ps.fpsm == GS_PSM_CT24;
+    ps.frameCT32 = ps.fpsm == GS_PSM_CT32;
+    ps.depthZ16S = ps.zpsm == GS_PSM_Z16S;
+    ps.pageTableZ16S = &GSMem::GetPageTableZ16S();
+    ps.forceAlphaMsb = (ctx.fba & 0x1ull) != 0ull && ctx.frame.psm != GS_PSM_CT24;
+    ps.zmask = ctx.zbuf.zmask != 0;
+}
+
+void GSCpuBackend::PrepareTextureSetup(const GSDrawState &state, TextureSetup &ts) const
+{
+    const auto &ctx = state.context;
+    const auto &tex = ctx.tex0;
+    ts.tex = &tex;
+    ts.texa = state.texa;
+    ts.texW = state.textureWidth;
+    ts.texH = state.textureHeight;
+    const uint64_t clamp = ctx.clamp;
+    ts.wrapU = static_cast<uint8_t>(clamp & 0x3u);
+    ts.wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+    ts.minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+    ts.maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+    ts.minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+    ts.maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+    ts.fst = state.prim.fst != 0;
+    ts.linearFilter = state.linearFilter;
+
+    ts.psm = tex.psm;
+    ts.tbp0 = tex.tbp0;
+    ts.tbw = tex.tbw;
+    ts.reader = GSMem::GetReadTextureFunc(tex.psm);
+    ts.directCT32 = tex.psm == GS_PSM_CT32;
+    ts.pageTableC32 = &GSMem::GetPageTableC32();
+
+    switch (tex.psm)
+    {
+    case GS_PSM_CT32:
+    case GS_PSM_Z32:
+    case GS_PSM_CT24:
+    case GS_PSM_Z24:
+        ts.kind = TextureSetup::Kind::Direct;
+        break;
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+    case GS_PSM_Z16:
+    case GS_PSM_Z16S:
+        ts.kind = TextureSetup::Kind::Direct16;
+        break;
+    case GS_PSM_T8:
+    case GS_PSM_T8H:
+    case GS_PSM_T4:
+    case GS_PSM_T4HL:
+    case GS_PSM_T4HH:
+        ts.kind = TextureSetup::Kind::Clut;
+        break;
+    default:
+        ts.kind = TextureSetup::Kind::Invalid;
+        break;
+    }
+
+    ts.cpsm = tex.cpsm;
+    ts.clutSixteenBit = tex.cpsm == GS_PSM_CT16 || tex.cpsm == GS_PSM_CT16S;
+    const uint32_t csaMask = ts.clutSixteenBit ? 0x1Fu : 0x0Fu;
+    ts.clutBase = (static_cast<uint32_t>(tex.csa) & csaMask) << 4u;
+    ts.clutFourBitSource = isFourBitIndexedPsm(tex.psm);
+    ts.clutCsm1EightBit = !ts.clutSixteenBit && tex.csm == 0u && isEightBitIndexedPsm(tex.psm);
+}
+
+GS_FORCEINLINE uint32_t GSCpuBackend::SampleTexelFast(const TextureSetup &ts, int sampleU, int sampleV)
+{
+    sampleU = wrapTextureCoordinate(sampleU, ts.texW, ts.wrapU, ts.minU, ts.maxU);
+    sampleV = wrapTextureCoordinate(sampleV, ts.texH, ts.wrapV, ts.minV, ts.maxV);
+
+    if (ts.directCT32)
+    {
+        // Inlined GSMem::ReadTexture for PSMCT32 (applyTexa is the identity for CT32).
+        const uint32_t address = swizzledByteAddress<GSMem::C32>(*ts.pageTableC32, ts.tbp0, ts.tbw,
+                                                                 static_cast<u32>(sampleU), static_cast<u32>(sampleV));
+        return load32(m_texturePageCache.ResolveDeferred(m_vram, address));
+    }
+
+    const u32 out = ts.reader(m_texturePageCache, m_vram, ts.tbp0, ts.tbw,
+                              static_cast<u32>(sampleU), static_cast<u32>(sampleV));
+
+    switch (ts.kind)
+    {
+    case TextureSetup::Kind::Direct:
+        return applyTexa(ts.texa, ts.psm, out);
+    case TextureSetup::Kind::Direct16:
+        return applyTexa(ts.texa, ts.psm, Rgba5551ToRgba8888(static_cast<u16>(out)));
+    case TextureSetup::Kind::Clut:
+    {
+        const uint8_t index = static_cast<u8>(out);
+        const uint32_t sourceIndex = ts.clutFourBitSource
+                                         ? (static_cast<uint32_t>(index) & 0x0Fu)
+                                         : static_cast<uint32_t>(index);
+        uint32_t clutIndex = (ts.clutBase + sourceIndex) & (ts.clutSixteenBit ? 0x1FFu : 0x0FFu);
+        if (ts.clutCsm1EightBit)
+        {
+            const uint32_t block = std::min((sourceIndex & 0xF0u) + ts.clutBase, 240u);
+            clutIndex = block + (sourceIndex & 0x0Fu);
+        }
+
+        switch (ts.cpsm)
+        {
+        case GS_PSM_CT32:
+        {
+            const uint32_t raw = static_cast<uint32_t>(m_clut[clutIndex]) | (static_cast<uint32_t>(m_clut[clutIndex + 256u]) << 16u);
+            return applyTexa(ts.texa, ts.cpsm, raw);
+        }
+        case GS_PSM_CT24:
+        {
+            const uint32_t raw = static_cast<uint32_t>(m_clut[clutIndex]) | (static_cast<uint32_t>(m_clut[clutIndex + 256u]) << 16u);
+            return applyTexa(ts.texa, ts.cpsm, raw & 0x00FFFFFFu);
+        }
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+            return applyTexa(ts.texa, ts.cpsm, Rgba5551ToRgba8888(m_clut[clutIndex]));
+        default:
+            break;
+        }
+        return 0xFFFF00FFu;
+    }
+    default:
+        break;
+    }
+
+    return 0xFFFF00FFu;
+}
+
+GS_FORCEINLINE uint32_t GSCpuBackend::SampleTextureFast(const TextureSetup &ts, float s, float t, float q, uint16_t u, uint16_t v)
+{
+    const int texW = ts.texW;
+    const int texH = ts.texH;
+
+    float texUf, texVf;
+    if (ts.fst)
+    {
+        texUf = static_cast<float>(u) / 16.0f;
+        texVf = static_cast<float>(v) / 16.0f;
+    }
+    else
+    {
+        const float invQ = 1.0f / fabsQ(q);
+        texUf = s * invQ * static_cast<float>(texW);
+        texVf = t * invQ * static_cast<float>(texH);
+    }
+
+    if (!ts.linearFilter)
+    {
+        return SampleTexelFast(ts, static_cast<int>(texUf), static_cast<int>(texVf));
+    }
+
+    const float sampleU = texUf - 0.5f;
+    const float sampleV = texVf - 0.5f;
+    const int u0 = static_cast<int>(std::floor(sampleU));
+    const int v0 = static_cast<int>(std::floor(sampleV));
+    const int u1 = u0 + 1;
+    const int v1 = v0 + 1;
+    const float fx = sampleU - static_cast<float>(u0);
+    const float fy = sampleV - static_cast<float>(v0);
+
+    const uint32_t c00 = SampleTexelFast(ts, u0, v0);
+    const uint32_t c10 = SampleTexelFast(ts, u1, v0);
+    const uint32_t c01 = SampleTexelFast(ts, u0, v1);
+    const uint32_t c11 = SampleTexelFast(ts, u1, v1);
+
+    // All four channels at once. This is the exact operation sequence the
+    // scalar lerpChannel compiles to under /fp:fast + /arch:AVX2 (fused
+    // multiply-add for both horizontal lerps and the vertical one), followed
+    // by the same round-half-away-from-zero + clamp as roundToU8, so the
+    // result is bit-identical while doing 1/4 of the work.
+    const __m128 f00 = _mm_cvtepi32_ps(_mm_cvtepu8_epi32(_mm_cvtsi32_si128(static_cast<int>(c00))));
+    const __m128 f10 = _mm_cvtepi32_ps(_mm_cvtepu8_epi32(_mm_cvtsi32_si128(static_cast<int>(c10))));
+    const __m128 f01 = _mm_cvtepi32_ps(_mm_cvtepu8_epi32(_mm_cvtsi32_si128(static_cast<int>(c01))));
+    const __m128 f11 = _mm_cvtepi32_ps(_mm_cvtepu8_epi32(_mm_cvtsi32_si128(static_cast<int>(c11))));
+    const __m128 vfx = _mm_set1_ps(fx);
+    const __m128 vfy = _mm_set1_ps(fy);
+    const __m128 top = _mm_fmadd_ps(_mm_sub_ps(f10, f00), vfx, f00);
+    const __m128 bottom = _mm_fmadd_ps(_mm_sub_ps(f11, f01), vfx, f01);
+    const __m128 value = _mm_fmadd_ps(_mm_sub_ps(bottom, top), vfy, top);
+    const __m128i truncated = _mm_cvttps_epi32(value);
+    const __m128 fraction = _mm_sub_ps(value, _mm_cvtepi32_ps(truncated));
+    const __m128i roundUp = _mm_castps_si128(_mm_cmp_ps(fraction, _mm_set1_ps(0.5f), _CMP_GE_OQ));
+    const __m128i rounded = _mm_sub_epi32(truncated, roundUp); // mask is -1 where rounding up
+    const __m128i packed16 = _mm_packs_epi32(rounded, rounded);
+    const __m128i packed8 = _mm_packus_epi16(packed16, packed16);
+    return static_cast<uint32_t>(_mm_cvtsi128_si32(packed8));
+}
+
+// Same semantics as WritePixel, with the primitive-invariant decoding done
+// once in PreparePixelSetup.
+GS_FORCEINLINE void GSCpuBackend::WritePixelFast(const PixelSetup &ps, int x, int y, uint32_t z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog)
+{
+    if (x < ps.scissorX0 || x > ps.scissorX1 || y < ps.scissorY0 || y > ps.scissorY1)
+        return;
+
+    if (ps.fge)
+    {
+        const uint32_t inverseFog = 255u - fog;
+        r = static_cast<uint8_t>(((static_cast<uint32_t>(fog) * r) >> 8) + ((inverseFog * ps.fogR) >> 8));
+        g = static_cast<uint8_t>(((static_cast<uint32_t>(fog) * g) >> 8) + ((inverseFog * ps.fogG) >> 8));
+        b = static_cast<uint8_t>(((static_cast<uint32_t>(fog) * b) >> 8) + ((inverseFog * ps.fogB) >> 8));
+    }
+
+    PixelWriteMask writeMask{};
+    if (ps.alphaTestEnabled)
+    {
+        bool pass;
+        switch (ps.alphaTestMethod)
+        {
+        case 0:
+            pass = false;
+            break;
+        case 1:
+            pass = true;
+            break;
+        case 2:
+            pass = a < ps.alphaRef;
+            break;
+        case 3:
+            pass = a <= ps.alphaRef;
+            break;
+        case 4:
+            pass = a == ps.alphaRef;
+            break;
+        case 5:
+            pass = a >= ps.alphaRef;
+            break;
+        case 6:
+            pass = a > ps.alphaRef;
+            break;
+        case 7:
+            pass = a != ps.alphaRef;
+            break;
+        default:
+            pass = true;
+            break;
+        }
+        if (!pass)
+        {
+            writeMask = ps.alphaFailMask;
+            if (!writeMask.writesAnything())
+                return;
+        }
+    }
+
+    const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha && ps.frameCT32;
+    const bool frmw = ps.destinationAlphaTestNeedsRead ||
+                      (writeMask.writesFramebuffer() && ((ps.fbmsk != 0) || ps.alphaBlendEnabled || preserveDestinationAlpha));
+
+    u32 rawFramebufferPixel = 0;
+    u32 fbrgba = 0;
+    if (frmw)
+    {
+        // PSMCT32 inlined (identical to GSMem::ReadCT32).
+        rawFramebufferPixel = ps.frameCT32
+                                  ? load32(m_vram + swizzledByteAddress<GSMem::C32>(*ps.pageTableC32, ps.fbp, ps.fbw, static_cast<u32>(x), static_cast<u32>(y)))
+                                  : ps.frameCT24
+                                        ? (load32(m_vram + swizzledByteAddress<GSMem::C24>(*ps.pageTableC32, ps.fbp, ps.fbw, static_cast<u32>(x), static_cast<u32>(y))) & 0x00FFFFFFu)
+                                        : ps.readFrame(m_vram, ps.fbp, ps.fbw, x, y);
+        fbrgba = rawFramebufferPixel;
+
+        if (ps.frame16)
+        {
+            fbrgba = Rgba5551ToRgba8888(static_cast<u16>(fbrgba));
+        }
+        else if (ps.frameCT24)
+        {
+            fbrgba |= 0x80000000u;
+        }
+    }
+
+    if (ps.destinationAlphaTest && ps.destinationAlphaBit != 0u)
+    {
+        if ((((rawFramebufferPixel >> ps.destinationAlphaBit) & 0x1u) != 0u) != ps.destinationAlphaMode)
+            return;
+    }
+
+    auto readDepth = [&]() -> uint32_t
+    {
+        if (ps.depthZ16S)
+            return load16(m_vram + swizzledByteAddress<GSMem::Z16S>(*ps.pageTableZ16S, ps.zbp, ps.fbw, static_cast<u32>(x), static_cast<u32>(y)));
+        return ps.readDepth(m_vram, ps.zbp, ps.fbw, x, y);
+    };
+
+    switch (ps.ztestMethod)
+    {
+    case 0:
+        return;
+    case 1:
+        break;
+    case 2:
+        if (!(z >= readDepth()))
+            return;
+        break;
+    case 3:
+        if (!(z > readDepth()))
+            return;
+        break;
+    }
+
+    if (writeMask.writesFramebuffer())
+    {
+        if (ps.alphaBlendEnabled)
+        {
+            if (!(ps.pabe && (a & 0x80u) == 0u))
+            {
+                const int dr = fbrgba & 0xFF;
+                const int dg = (fbrgba >> 8) & 0xFF;
+                const int db = (fbrgba >> 16) & 0xFF;
+                const int da = (fbrgba >> 24) & 0xFF;
+
+                auto pickRGB = [](uint8_t sel, int cs, int cd) -> int
+                {
+                    if (sel == 0)
+                        return cs;
+                    if (sel == 1)
+                        return cd;
+                    return 0;
+                };
+                const int cAlpha = (ps.csel == 0) ? a : (ps.csel == 1) ? da
+                                                                       : ps.fix;
+
+                r = clampU8(((pickRGB(ps.asel, r, dr) - pickRGB(ps.bsel, r, dr)) * cAlpha >> 7) + pickRGB(ps.dsel, r, dr));
+                g = clampU8(((pickRGB(ps.asel, g, dg) - pickRGB(ps.bsel, g, dg)) * cAlpha >> 7) + pickRGB(ps.dsel, g, dg));
+                b = clampU8(((pickRGB(ps.asel, b, db) - pickRGB(ps.bsel, b, db)) * cAlpha >> 7) + pickRGB(ps.dsel, b, db));
+            }
+        }
+
+        if (writeMask.writeAlpha && ps.forceAlphaMsb)
+        {
+            a = static_cast<uint8_t>(a | 0x80u);
+        }
+
+        u32 pixel = pack32(r, g, b, a);
+
+        if (ps.fbmsk != 0)
+        {
+            pixel = (pixel & ~ps.fbmsk) | (fbrgba & ps.fbmsk);
+        }
+
+        if (preserveDestinationAlpha)
+        {
+            pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+        }
+
+        if (ps.frame16)
+        {
+            pixel = Rgba8888ToRgba5551(pixel);
+        }
+
+        if (ps.frameCT32)
+        {
+            const uint32_t address = swizzledByteAddress<GSMem::C32>(*ps.pageTableC32, ps.fbp, ps.fbw, static_cast<u32>(x), static_cast<u32>(y));
+            m_texturePageCache.NotifyWrite(m_vram, address);
+            store32(m_vram + address, pixel);
+        }
+        else if (ps.frameCT24)
+        {
+            // Identical to GSMem::WriteCT24: keep the stored upper byte.
+            const uint32_t address = swizzledByteAddress<GSMem::C24>(*ps.pageTableC32, ps.fbp, ps.fbw, static_cast<u32>(x), static_cast<u32>(y));
+            m_texturePageCache.NotifyWrite(m_vram, address);
+            uint8_t *dst = m_vram + address;
+            store32(dst, (load32(dst) & 0xFF000000u) | (pixel & 0x00FFFFFFu));
+        }
+        else
+        {
+            m_texturePageCache.Materialize(m_vram);
+            ps.writeFrame(m_vram, ps.fbp, ps.fbw, x, y, pixel);
+        }
+    }
+
+    if (writeMask.writeDepth && !ps.zmask)
+    {
+        if (ps.depthZ16S)
+        {
+            const uint32_t address = swizzledByteAddress<GSMem::Z16S>(*ps.pageTableZ16S, ps.zbp, ps.fbw, static_cast<u32>(x), static_cast<u32>(y));
+            m_texturePageCache.NotifyWrite(m_vram, address);
+            store16(m_vram + address, static_cast<uint16_t>(z));
+        }
+        else
+        {
+            m_texturePageCache.Materialize(m_vram);
+            ps.writeDepth(m_vram, ps.zbp, ps.fbw, x, y, z);
+        }
+    }
+}
