+const uint8_t *GS::lockDisplaySnapshot(uint32_t &outSize)
+{
+    m_snapshotMutex.lock();
+    if (m_displaySnapshot.empty())
+    {
+        outSize = 0;
+        return nullptr;
+    }
+
+    outSize = static_cast<uint32_t>(m_displaySnapshot.size());
+    return m_displaySnapshot.data();
