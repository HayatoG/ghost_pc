+                }
+
+                if (!m_swsCtx ||
+                    m_swsWidth != width ||
+                    m_swsHeight != height ||
+                    m_swsFormat != srcFormat)
+                {
+                    if (m_swsCtx)
+                    {
+                        sws_freeContext(m_swsCtx);
+                        m_swsCtx = nullptr;
+                    }
+                    m_swsCtx = sws_getContext(
+                        width,
+                        height,
+                        srcFormat,
+                        width,
+                        height,
+                        AV_PIX_FMT_RGBA,
+                        SWS_BILINEAR,
+                        nullptr,
+                        nullptr,
+                        nullptr);
