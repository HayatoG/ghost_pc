-                frameRateDenominator = 1001u;
-                break;
-            case 2u:
-                frameRateNumerator = 24u;
-                break;
-            case 3u:
-                frameRateNumerator = 25u;
-                break;
-            case 4u:
-                frameRateNumerator = 30000u;
-                frameRateDenominator = 1001u;
-                break;
-            case 5u:
-                frameRateNumerator = 30u;
-                break;
-            case 6u:
-                frameRateNumerator = 50u;
-                break;
-            case 7u:
-                frameRateNumerator = 60000u;
-                frameRateDenominator = 1001u;
-                break;
-            case 8u:
-                frameRateNumerator = 60u;
