+namespace
+{
+    // One texture axis of a sprite, given the sprite-interpolated coordinate
+    // in texels: exactly what DrawSprite + SampleTextureFast compute for that
+    // axis (it only depends on the column for U and on the row for V).
+    GS_FORCEINLINE void spriteAxis(float texCoord, bool fst, bool linear, int size, uint8_t wrap,
+                                   uint16_t regionMin, uint16_t regionMax, int &i0, int &i1, float &frac)
+    {
+        float coord;
+        if (fst)
+        {
+            const int fixed = static_cast<int>((texCoord * 16.0f) + 0.5f);
+            const uint16_t sample = static_cast<uint16_t>(clampInt(fixed, 0, 0xFFFF));
+            coord = static_cast<float>(sample) / 16.0f;
+        }
+        else
+        {
+            const float s = texCoord / static_cast<float>(size);
+            const float invQ = 1.0f / fabsQ(1.0f);
+            coord = s * invQ * static_cast<float>(size);
+        }
+
+        if (!linear)
+        {
+            i0 = wrapTextureCoordinate(static_cast<int>(coord), size, wrap, regionMin, regionMax);
+            i1 = i0;
+            frac = 0.0f;
+            return;
+        }
+        const float sample = coord - 0.5f;
+        const int c0 = static_cast<int>(std::floor(sample));
+        frac = sample - static_cast<float>(c0);
+        i0 = wrapTextureCoordinate(c0, size, wrap, regionMin, regionMax);
+        i1 = wrapTextureCoordinate(c0 + 1, size, wrap, regionMin, regionMax);
+    }
+}
+
+void GSCpuBackend::PreparePixelColumns(const PixelSetup &ps, int drawX0, int drawX1)
+{
+    const size_t columns = static_cast<size_t>(drawX1 - drawX0 + 1);
+    if (m_pixelColumns.size() < columns)
+        m_pixelColumns.resize(columns);
+    PixelColumn *const pcols = m_pixelColumns.data();
+    for (int x = drawX0; x <= drawX1; ++x)
+        pcols[x - drawX0] = {ps.FbColumn(x), ps.ZColumn(x)};
+}
+
+template <int TexKind>
+void GSCpuBackend::DrawSpriteTextured(const GSPrimitiveBatch &batch, int drawX0, int drawY0, int drawX1, int drawY1,
+                                      int unclippedX0, int unclippedY0, int spanX, int spanY)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const auto &tex = state.context.tex0;
+    const PixelSetup pixelSetup = *m_pixelSetup; // local copy: VRAM stores cannot alias it
+    const TextureSetup textureSetup = *m_textureSetup;
+    const int texW = state.textureWidth;
+    const int texH = state.textureHeight;
+    const u32 z1 = static_cast<u32>(v1.z);
+    const uint8_t r = v1.r, g = v1.g, b = v1.b, a = v1.a;
+    const uint8_t fog = v1.fog;
+    const bool fst = state.prim.fst;
+    const bool linear = textureSetup.linearFilter;
+
+    float u0f, v0f, u1f, v1f;
+    if (fst)
+    {
+        u0f = static_cast<float>(v0.u >> 4);
+        v0f = static_cast<float>(v0.v >> 4);
+        u1f = static_cast<float>(v1.u >> 4);
+        v1f = static_cast<float>(v1.v >> 4);
+    }
+    else
+    {
+        const float q0 = fabsQ(v0.q);
+        const float q1 = fabsQ(v1.q);
+        u0f = (v0.s / q0) * static_cast<float>(texW);
+        v0f = (v0.t / q0) * static_cast<float>(texH);
+        u1f = (v1.s / q1) * static_cast<float>(texW);
+        v1f = (v1.t / q1) * static_cast<float>(texH);
+    }
+
+    float spriteW = static_cast<float>(spanX);
+    float spriteH = static_cast<float>(spanY);
+    if (spriteW < 1.0f)
+        spriteW = 1.0f;
+    if (spriteH < 1.0f)
+        spriteH = 1.0f;
+
+    // PSMCT32/24 textures: the swizzle is separable too, so the texel address
+    // is base + row term + column term (same result as readTexelInline).
+    constexpr bool kSeparableTex = TexKind == kTexC32 || TexKind == kTexC24;
+    const SeparableSwizzle &texSwz = swizzleC32();
+    const uint32_t texBase = texSwz.Base(textureSetup.tbp0);
+    auto fetchSeparable = [&](uint32_t rowTerm, uint32_t columnTerm) -> uint32_t
+    {
+        const uint32_t address = ((texBase + rowTerm + columnTerm) * 4u) & kMask32;
+        const uint32_t v = load32(m_texturePageCache.ResolveDeferred(m_vram, address));
+        if constexpr (TexKind == kTexC24)
+            return applyTexa(textureSetup.texa, GS_PSM_CT24, v & 0x00FFFFFFu);
+        else
+            return v; // applyTexa is the identity for CT32
+    };
+
+    // The U side of the sampling only depends on the column: compute it once
+    // per column instead of once per pixel.
+    const size_t columns = static_cast<size_t>(drawX1 - drawX0 + 1);
+    if (m_spriteColumns.size() < columns)
+        m_spriteColumns.resize(columns);
+    SpriteAxis *const cols = m_spriteColumns.data();
+    for (int x = drawX0; x <= drawX1; ++x)
+    {
+        const float tx = (static_cast<float>(x - unclippedX0) + 0.5f) / spriteW;
+        const float texUf = u0f + (u1f - u0f) * tx;
+        SpriteAxis &c = cols[x - drawX0];
+        spriteAxis(texUf, fst, linear, texW, textureSetup.wrapU, textureSetup.minU, textureSetup.maxU, c.i0, c.i1, c.f);
+        if constexpr (kSeparableTex)
+        {
+            c.s0 = texSwz.Column(static_cast<uint32_t>(c.i0));
+            c.s1 = texSwz.Column(static_cast<uint32_t>(c.i1));
+        }
+    }
+
+    PreparePixelColumns(pixelSetup, drawX0, drawX1);
+    const PixelColumn *const pcols = m_pixelColumns.data();
+
+    for (int y = drawY0; y <= drawY1; ++y)
+    {
+        const uint32_t fbRow = pixelSetup.FbRow(y);
+        const uint32_t zRow = pixelSetup.ZRow(y);
+        const float ty = (static_cast<float>(y - unclippedY0) + 0.5f) / spriteH;
+        const float texVf = v0f + (v1f - v0f) * ty;
+        SpriteAxis row;
+        spriteAxis(texVf, fst, linear, texH, textureSetup.wrapV, textureSetup.minV, textureSetup.maxV, row.i0, row.i1, row.f);
+        if constexpr (kSeparableTex)
+        {
+            row.s0 = texSwz.Row(textureSetup.tbw, static_cast<uint32_t>(row.i0));
+            row.s1 = texSwz.Row(textureSetup.tbw, static_cast<uint32_t>(row.i1));
+        }
+
+        for (int x = drawX0; x <= drawX1; ++x)
+        {
+            const SpriteAxis &c = cols[x - drawX0];
+            uint32_t texel;
+            if constexpr (kSeparableTex)
+            {
+                if (!linear)
+                {
+                    texel = fetchSeparable(row.s0, c.s0);
+                }
+                else
+                {
+                    const uint32_t c00 = fetchSeparable(row.s0, c.s0);
+                    const uint32_t c10 = fetchSeparable(row.s0, c.s1);
+                    const uint32_t c01 = fetchSeparable(row.s1, c.s0);
+                    const uint32_t c11 = fetchSeparable(row.s1, c.s1);
+                    texel = bilinearBlend(c00, c10, c01, c11, c.f, row.f);
+                }
+            }
+            else if (!linear)
+            {
+                texel = FetchTexel<TexKind>(textureSetup, c.i0, row.i0);
+            }
+            else
+            {
+                // Same fetch order as SampleTextureFast (it drives the page cache).
+                const uint32_t c00 = FetchTexel<TexKind>(textureSetup, c.i0, row.i0);
+                const uint32_t c10 = FetchTexel<TexKind>(textureSetup, c.i1, row.i0);
+                const uint32_t c01 = FetchTexel<TexKind>(textureSetup, c.i0, row.i1);
+                const uint32_t c11 = FetchTexel<TexKind>(textureSetup, c.i1, row.i1);
+                texel = bilinearBlend(c00, c10, c01, c11, c.f, row.f);
+            }
+
+            const uint32_t color = combineTexturePacked(tex, r, g, b, a, texel);
+            const PixelColumn &pc = pcols[x - drawX0];
+            if (pixelSetup.simpleWrite)
+            {
+                WritePixelSimple(pixelSetup, z1, color, pixelSetup.FbAddress(fbRow, pc.fb), pixelSetup.ZAddress(zRow, pc.z));
+                continue;
+            }
+            if (pixelSetup.simpleBlend)
+            {
+                WritePixelSimpleBlend(pixelSetup, z1, color, pixelSetup.FbAddress(fbRow, pc.fb), pixelSetup.ZAddress(zRow, pc.z));
+                continue;
+            }
+            WritePixelFast(pixelSetup, x, y, z1, static_cast<uint8_t>(color), static_cast<uint8_t>(color >> 8),
+                           static_cast<uint8_t>(color >> 16), static_cast<uint8_t>(color >> 24), fog,
+                           pixelSetup.FbAddress(fbRow, pc.fb), pixelSetup.ZAddress(zRow, pc.z));
+        }
+    }
+}
+
+void GSCpuBackend::DrawSprite(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const auto &ctx = state.context;
+
+    int ofx = ctx.xyoffset.ofx >> 4;
+    int ofy = ctx.xyoffset.ofy >> 4;
+
+    // GS sprite coverage is [ceil(x0), ceil(x1)) (pixel centres sit on integer coordinates), so an edge at
+    // 63.5 still covers pixel 63. Truncating instead leaves a 1px seam between adjacent strips; Ghost in the
+    // Shell draws its full-screen transitions as 64px strips with x1 = x0 + 63.5.
+    int x0 = static_cast<int>(std::ceil(v0.x)) - ofx;
+    int y0 = static_cast<int>(std::ceil(v0.y)) - ofy;
+    int x1 = static_cast<int>(std::ceil(v1.x)) - ofx;
+    int y1 = static_cast<int>(std::ceil(v1.y)) - ofy;
+    u32 z1 = static_cast<u32>(v1.z);
+
+    if (x0 > x1)
+        std::swap(x0, x1);
+    if (y0 > y1)
+        std::swap(y0, y1);
+
+    const int unclippedX0 = x0;
+    const int unclippedY0 = y0;
+    const int spanX = std::max(1, x1 - x0);
+    const int spanY = std::max(1, y1 - y0);
+    const int unclippedX1 = unclippedX0 + spanX - 1;
+    const int unclippedY1 = unclippedY0 + spanY - 1;
+
+    // If the sprite rectangle is fully outside scissor, nothing should render.
+    if (unclippedX1 < ctx.scissor.x0 || unclippedX0 > ctx.scissor.x1 ||
+        unclippedY1 < ctx.scissor.y0 || unclippedY0 > ctx.scissor.y1)
+        return;
+
+    const int drawX0 = clampInt(unclippedX0, ctx.scissor.x0, ctx.scissor.x1);
+    const int drawY0 = clampInt(unclippedY0, ctx.scissor.y0, ctx.scissor.y1);
+    const int drawX1 = clampInt(unclippedX1, ctx.scissor.x0, ctx.scissor.x1);
+    const int drawY1 = clampInt(unclippedY1, ctx.scissor.y0, ctx.scissor.y1);
+
+    PrepareSetups(state, state.prim.tme);
+
+    if (state.prim.tme)
+    {
+        int kind = m_textureSetup->fastKind;
+        if ((kind == kTexC32 || kind == kTexC24) && !swizzleC32().valid)
+            kind = kTexGeneric;
+        switch (kind)
+        {
+        case kTexC32:
+            DrawSpriteTextured<kTexC32>(batch, drawX0, drawY0, drawX1, drawY1, unclippedX0, unclippedY0, spanX, spanY);
+            break;
+        case kTexC24:
+            DrawSpriteTextured<kTexC24>(batch, drawX0, drawY0, drawX1, drawY1, unclippedX0, unclippedY0, spanX, spanY);
+            break;
+        case kTexP8:
+            DrawSpriteTextured<kTexP8>(batch, drawX0, drawY0, drawX1, drawY1, unclippedX0, unclippedY0, spanX, spanY);
+            break;
+        case kTexP4:
+            DrawSpriteTextured<kTexP4>(batch, drawX0, drawY0, drawX1, drawY1, unclippedX0, unclippedY0, spanX, spanY);
+            break;
+        default:
+            DrawSpriteTextured<kTexGeneric>(batch, drawX0, drawY0, drawX1, drawY1, unclippedX0, unclippedY0, spanX, spanY);
+            break;
+        }
+    }
+    else
+    {
+        const PixelSetup pixelSetup = *m_pixelSetup; // local copy: VRAM stores cannot alias it
+        const uint8_t r = v1.r, g = v1.g, b = v1.b, a = v1.a;
+        const uint8_t fog = v1.fog;
+        PreparePixelColumns(pixelSetup, drawX0, drawX1);
+        const PixelColumn *const pcols = m_pixelColumns.data();
+        for (int y = drawY0; y <= drawY1; ++y)
+        {
+            const uint32_t fbRow = pixelSetup.FbRow(y);
+            const uint32_t zRow = pixelSetup.ZRow(y);
+            if (pixelSetup.simpleWrite)
+            {
+                const uint32_t rgba = pack32(r, g, b, a);
+                for (int x = drawX0; x <= drawX1; ++x)
+                {
+                    const PixelColumn &pc = pcols[x - drawX0];
+                    WritePixelSimple(pixelSetup, z1, rgba, pixelSetup.FbAddress(fbRow, pc.fb), pixelSetup.ZAddress(zRow, pc.z));
+                }
+                continue;
+            }
+            for (int x = drawX0; x <= drawX1; ++x)
+            {
+                const PixelColumn &pc = pcols[x - drawX0];
+                WritePixelFast(pixelSetup, x, y, z1, r, g, b, a, fog, pixelSetup.FbAddress(fbRow, pc.fb),
+                               pixelSetup.ZAddress(zRow, pc.z));
+            }
+        }
+    }
+
+    // Never leave a deferred texture-page snapshot outside the primitive.
+    m_texturePageCache.Materialize(m_vram);
+}
+
+struct GSCpuBackend::TriangleGeometry
+{
+    float fx0, fy0, fx1, fy1, fx2, fy2;
+    int minX, maxX, minY, maxY;
+    float winding;
+    float invAbsDenom;
+};
+
+void GSCpuBackend::DrawTriangle(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const GSVertex &v2 = batch.vertices[2];
+    const auto &ctx = state.context;
+
+    int ofx = ctx.xyoffset.ofx >> 4;
+    int ofy = ctx.xyoffset.ofy >> 4;
+
+    TriangleGeometry geo;
+    float &fx0 = geo.fx0, &fy0 = geo.fy0, &fx1 = geo.fx1, &fy1 = geo.fy1, &fx2 = geo.fx2, &fy2 = geo.fy2;
+    fx0 = v0.x - static_cast<float>(ofx);
+    fy0 = v0.y - static_cast<float>(ofy);
+    fx1 = v1.x - static_cast<float>(ofx);
+    fy1 = v1.y - static_cast<float>(ofy);
+    fx2 = v2.x - static_cast<float>(ofx);
+    fy2 = v2.y - static_cast<float>(ofy);
+
+    int minX = static_cast<int>(std::floor(std::min({fx0, fx1, fx2})));
+    int maxX = static_cast<int>(std::ceil(std::max({fx0, fx1, fx2})));
+    int minY = static_cast<int>(std::floor(std::min({fy0, fy1, fy2})));
+    int maxY = static_cast<int>(std::ceil(std::max({fy0, fy1, fy2})));
+
+    geo.minX = clampInt(minX, ctx.scissor.x0, ctx.scissor.x1);
+    geo.maxX = clampInt(maxX, ctx.scissor.x0, ctx.scissor.x1);
+    geo.minY = clampInt(minY, ctx.scissor.y0, ctx.scissor.y1);
+    geo.maxY = clampInt(maxY, ctx.scissor.y0, ctx.scissor.y1);
+
+    // (fy1 - fy2) * (fx0 - fx2) + (fx2 - fx1) * (fy0 - fy2), second product rounded.
+    const float denom = fmaF(subF(fx0, fx2), subF(fy1, fy2), mulF(subF(fy0, fy2), subF(fx2, fx1)));
+    if (std::fabs(denom) < 0.001f)
+        return;
+
+    geo.winding = (denom < 0.0f) ? -1.0f : 1.0f;
+    geo.invAbsDenom = 1.0f / std::fabs(denom);
+
+    PrepareSetups(state, state.prim.tme);
+    const int kind = state.prim.tme ? m_textureSetup->fastKind : kTexGeneric;
+    switch (kind)
+    {
+    case kTexC32:
+        DrawTriangleT<kTexC32>(batch, geo);
+        break;
+    case kTexC24:
+        DrawTriangleT<kTexC24>(batch, geo);
+        break;
+    case kTexP8:
+        DrawTriangleT<kTexP8>(batch, geo);
+        break;
+    case kTexP4:
+        DrawTriangleT<kTexP4>(batch, geo);
+        break;
+    default:
+        DrawTriangleT<kTexGeneric>(batch, geo);
+        break;
+    }
+
+    // Never leave a deferred texture-page snapshot outside the primitive.
+    m_texturePageCache.Materialize(m_vram);
+}
+
+// Triangle rasterization, 4 pixels of a row at a time. Each SIMD lane runs
+// exactly the scalar operation sequence of the original per-pixel code (as
+// compiled under /fp:fast: which products are fused into FMAs was read from
+// its disassembly), so every lane is bit-identical to the scalar result. The
+// per-pixel work that touches memory (texture fetch, framebuffer/Z) stays
+// scalar and in the original pixel order, which keeps the texture page cache
+// behaviour identical.
+template <int TexKind>
+void GSCpuBackend::DrawTriangleT(const GSPrimitiveBatch &batch, const TriangleGeometry &geo)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const GSVertex &v2 = batch.vertices[2];
+    const auto &tex = state.context.tex0;
+
+    const float fx0 = geo.fx0, fy0 = geo.fy0, fx1 = geo.fx1, fy1 = geo.fy1, fx2 = geo.fx2, fy2 = geo.fy2;
+    const int minX = geo.minX, maxX = geo.maxX, minY = geo.minY, maxY = geo.maxY;
+    constexpr float kEdgeEpsilon = 1.0e-4f;
+
+    const PixelSetup pixelSetup = *m_pixelSetup; // local copy: VRAM stores cannot alias it
+    const TextureSetup textureSetup = *m_textureSetup;
+    const bool iip = state.prim.iip;
+    const bool tme = state.prim.tme;
+    const bool fst = state.prim.fst;
+    const bool linear = tme && textureSetup.linearFilter;
+
+    // w0 = ((fy1-fy2)*(px-fx2) + (fx2-fx1)*(py-fy2)) * winding * invAbsDenom
+    // w1 = ((fy2-fy0)*(px-fx2) + (fx0-fx2)*(py-fy2)) * winding * invAbsDenom
+    // The y-dependent product is rounded, the x-dependent one fused.
+    const __m128 e0x = _mm_set1_ps(fy1 - fy2);
+    const float e0y = fx2 - fx1;
+    const __m128 e1x = _mm_set1_ps(fy2 - fy0);
+    const float e1y = fx0 - fx2;
+    const __m128 vfx2 = _mm_set1_ps(fx2);
+    const __m128 vwinding = _mm_set1_ps(geo.winding);
+    const __m128 vinv = _mm_set1_ps(geo.invAbsDenom);
+    const __m128 vone = _mm_set1_ps(1.0f);
+    const __m128 vhalf = _mm_set1_ps(0.5f);
+    const __m128 vnegEps = _mm_set1_ps(-kEdgeEpsilon);
+    const __m128i laneIndex = _mm_setr_epi32(0, 1, 2, 3);
+
+    // Attribute = a0*w0 + a1*w1 + a2*w2: first product rounded, the others
+    // fused left to right.
+    auto attr = [](float a0, float a1, float a2, __m128 w0, __m128 w1, __m128 w2) -> __m128
+    {
+        return _mm_fmadd_ps(w2, _mm_set1_ps(a2), _mm_fmadd_ps(w1, _mm_set1_ps(a1), _mm_mul_ps(_mm_set1_ps(a0), w0)));
+    };
+    auto toU8 = [](__m128 v) -> __m128i
+    {
+        // clampU8(static_cast<int>(v)); cvtt gives INT_MIN for NaN/overflow like the scalar cvttss2si.
+        return _mm_min_epi32(_mm_max_epi32(_mm_cvttps_epi32(v), _mm_setzero_si128()), _mm_set1_epi32(255));
+    };
+    const __m256d z0 = _mm256_set1_pd(v0.z), z1 = _mm256_set1_pd(v1.z), z2 = _mm256_set1_pd(v2.z);
+
+    alignas(32) double Z[4];
+    alignas(16) int R[4], G[4], B[4], A[4], F[4], U0[4], V0[4], U1[4], V1[4];
+    alignas(16) float FX[4], FY[4];
+    const float texWf = static_cast<float>(textureSetup.texW);
+    const float texHf = static_cast<float>(textureSetup.texH);
+
+    // Fast texture kinds: wrap and the coordinate part of the compact
+    // swizzle address are computed for 4 lanes at once (exact integer
+    // equivalents of wrapTextureCoordinate / readTexelCompact); per texel only
+    // the T0 lookup, the VRAM read and the CLUT remain (in the original order).
+    constexpr bool kCompact = TexKind != kTexGeneric;
+    constexpr uint32_t kLog2PageW = (TexKind == kTexP8 || TexKind == kTexP4) ? 7u : 6u;
+    constexpr uint32_t kLog2PageH = TexKind == kTexP4 ? 7u : (TexKind == kTexP8 ? 6u : 5u);
+    alignas(16) uint32_t PRE[4][4], IDX[4][4]; // [tap][lane]
+    auto wrapLanes = [](__m128i c, int size, uint8_t mode, uint16_t regionMin, uint16_t regionMax) -> __m128i
+    {
+        switch (mode & 0x3u)
+        {
+        case 0: // REPEAT
+            return _mm_and_si128(c, _mm_set1_epi32(size - 1));
+        case 1: // CLAMP
+            return _mm_min_epi32(_mm_max_epi32(c, _mm_setzero_si128()), _mm_set1_epi32(size - 1));
+        case 2: // REGION_CLAMP
+            return _mm_min_epi32(_mm_max_epi32(c, _mm_set1_epi32(regionMin)), _mm_set1_epi32(regionMax));
+        default: // REGION_REPEAT
+            return _mm_or_si128(_mm_and_si128(c, _mm_set1_epi32(regionMin)), _mm_set1_epi32(regionMax));
+        }
+    };
+    auto storeTap = [&](int tap, __m128i u, __m128i v)
+    {
+        const __m128i xw = wrapLanes(u, textureSetup.texW, textureSetup.wrapU, textureSetup.minU, textureSetup.maxU);
+        const __m128i yw = wrapLanes(v, textureSetup.texH, textureSetup.wrapV, textureSetup.minV, textureSetup.maxV);
+        const __m128i page = _mm_add_epi32(_mm_mullo_epi32(_mm_srli_epi32(yw, kLog2PageH), _mm_set1_epi32(static_cast<int>(textureSetup.compactRowPages))),
+                                           _mm_srli_epi32(xw, kLog2PageW));
+        const __m128i pre = _mm_add_epi32(_mm_set1_epi32(static_cast<int>(textureSetup.compactBase)),
+                                          _mm_slli_epi32(page, kLog2PageW + kLog2PageH));
+        const __m128i idx = _mm_or_si128(_mm_slli_epi32(_mm_and_si128(yw, _mm_set1_epi32((1 << kLog2PageH) - 1)), kLog2PageW),
+                                         _mm_and_si128(xw, _mm_set1_epi32((1 << kLog2PageW) - 1)));
+        _mm_store_si128(reinterpret_cast<__m128i *>(PRE[tap]), pre);
+        _mm_store_si128(reinterpret_cast<__m128i *>(IDX[tap]), idx);
+    };
+    auto fetchTap = [&](int tap, unsigned lane) -> uint32_t
+    {
+        const uint32_t pixelAddress = PRE[tap][lane] + textureSetup.compactT0[IDX[tap][lane]];
+        if constexpr (TexKind == kTexC32 || TexKind == kTexC24)
+        {
+            const uint32_t v = load32(m_texturePageCache.ResolveDeferred(m_vram, ((pixelAddress * 32u) / 8u) & kMask32));
+            if constexpr (TexKind == kTexC24)
+                return applyTexa(textureSetup.texa, GS_PSM_CT24, v & 0x00FFFFFFu);
+            else
+                return v;
+        }
+        else if constexpr (TexKind == kTexP8)
+        {
+            const uint8_t index = *m_texturePageCache.ResolveDeferred(m_vram, ((pixelAddress * 8u) / 8u) & static_cast<uint32_t>(GSMem::MEMORY_SIZE - 1u));
+            return textureSetup.clutTable[index];
+        }
+        else
+        {
+            const uint32_t bits = pixelAddress * 4u;
+            const uint8_t packed = *m_texturePageCache.ResolveDeferred(m_vram, (bits / 8u) & static_cast<uint32_t>(GSMem::MEMORY_SIZE - 1u));
+            return textureSetup.clutTable[(packed >> (bits % 8u)) & 0x0Fu];
+        }
+    };
+
+    for (int y = minY; y <= maxY; ++y)
+    {
+        const float py = static_cast<float>(y) + 0.5f;
+        const float dy = py - fy2;
+        const __m128 row0 = _mm_set1_ps(dy * e0y);
+        const __m128 row1 = _mm_set1_ps(e1y * dy);
+        const uint32_t fbRow = pixelSetup.FbRow(y);
+        const uint32_t zRow = pixelSetup.ZRow(y);
+        for (int x = minX; x <= maxX; x += 4)
+        {
+            const __m128i xi = _mm_add_epi32(_mm_set1_epi32(x), laneIndex);
+            const __m128 px = _mm_add_ps(_mm_cvtepi32_ps(xi), vhalf);
+            const __m128 dx = _mm_sub_ps(px, vfx2);
+            const __m128 w0 = _mm_mul_ps(_mm_mul_ps(_mm_fmadd_ps(e0x, dx, row0), vwinding), vinv);
+            const __m128 w1 = _mm_mul_ps(_mm_mul_ps(_mm_fmadd_ps(e1x, dx, row1), vwinding), vinv);
+            const __m128 w2 = _mm_sub_ps(_mm_sub_ps(vone, w0), w1);
+
+            // Skipped when w < -eps (ordered), so NaN weights are "inside" as before.
+            const __m128 inside = _mm_and_ps(_mm_and_ps(_mm_cmp_ps(w0, vnegEps, _CMP_NLT_UQ), _mm_cmp_ps(w1, vnegEps, _CMP_NLT_UQ)),
+                                             _mm_cmp_ps(w2, vnegEps, _CMP_NLT_UQ));
+            const int lanes = std::min(4, maxX - x + 1);
+            unsigned mask = static_cast<unsigned>(_mm_movemask_ps(inside)) & ((1u << lanes) - 1u);
+            if (mask == 0u)
+                continue;
+
+            {
+                const __m256d zz = _mm256_fmadd_pd(_mm256_cvtps_pd(w2), z2,
+                                                   _mm256_fmadd_pd(_mm256_cvtps_pd(w1), z1, _mm256_mul_pd(_mm256_cvtps_pd(w0), z0)));
+                _mm256_store_pd(Z, zz);
+            }
+            if (iip)
+            {
+                _mm_store_si128(reinterpret_cast<__m128i *>(R), toU8(attr(v0.r, v1.r, v2.r, w0, w1, w2)));
+                _mm_store_si128(reinterpret_cast<__m128i *>(G), toU8(attr(v0.g, v1.g, v2.g, w0, w1, w2)));
+                _mm_store_si128(reinterpret_cast<__m128i *>(B), toU8(attr(v0.b, v1.b, v2.b, w0, w1, w2)));
+                _mm_store_si128(reinterpret_cast<__m128i *>(A), toU8(attr(v0.a, v1.a, v2.a, w0, w1, w2)));
+            }
+            _mm_store_si128(reinterpret_cast<__m128i *>(F), toU8(attr(v0.fog, v1.fog, v2.fog, w0, w1, w2)));
+
+            if (tme)
+            {
+                __m128 texU, texV;
+                if (fst)
+                {
+                    // static_cast<uint16_t>(interp) then float(u) / 16.0f
+                    const __m128i mask16 = _mm_set1_epi32(0xFFFF);
+                    const __m128i iu = _mm_and_si128(_mm_cvttps_epi32(attr(v0.u, v1.u, v2.u, w0, w1, w2)), mask16);
+                    const __m128i iv = _mm_and_si128(_mm_cvttps_epi32(attr(v0.v, v1.v, v2.v, w0, w1, w2)), mask16);
+                    texU = _mm_mul_ps(_mm_cvtepi32_ps(iu), _mm_set1_ps(0.0625f));
+                    texV = _mm_mul_ps(_mm_cvtepi32_ps(iv), _mm_set1_ps(0.0625f));
+                }
+                else
+                {
+                    const __m128 is = attr(v0.s, v1.s, v2.s, w0, w1, w2);
+                    const __m128 it = attr(v0.t, v1.t, v2.t, w0, w1, w2);
+                    const __m128 iq = attr(v0.q, v1.q, v2.q, w0, w1, w2);
+                    // fabsQ: |q| > 1e-8 ? q : 1
+                    const __m128 absQ = _mm_andnot_ps(_mm_set1_ps(-0.0f), iq);
+                    const __m128 q = _mm_blendv_ps(vone, iq, _mm_cmp_ps(absQ, _mm_set1_ps(1.0e-8f), _CMP_GT_OQ));
+                    const __m128 invQ = _mm_div_ps(vone, q);
+                    texU = _mm_mul_ps(_mm_mul_ps(is, invQ), _mm_set1_ps(texWf));
+                    texV = _mm_mul_ps(_mm_mul_ps(it, invQ), _mm_set1_ps(texHf));
+                }
+                if (!linear)
+                {
+                    const __m128i iu0 = _mm_cvttps_epi32(texU);
+                    const __m128i iv0 = _mm_cvttps_epi32(texV);
+                    if constexpr (kCompact)
+                    {
+                        storeTap(0, iu0, iv0);
+                    }
+                    else
+                    {
+                        _mm_store_si128(reinterpret_cast<__m128i *>(U0), iu0);
+                        _mm_store_si128(reinterpret_cast<__m128i *>(V0), iv0);
+                    }
+                }
+                else
+                {
+                    const __m128 su = _mm_sub_ps(texU, vhalf);
+                    const __m128 sv = _mm_sub_ps(texV, vhalf);
+                    const __m128i iu0 = _mm_cvttps_epi32(_mm_floor_ps(su));
+                    const __m128i iv0 = _mm_cvttps_epi32(_mm_floor_ps(sv));
+                    const __m128i iu1 = _mm_add_epi32(iu0, _mm_set1_epi32(1));
+                    const __m128i iv1 = _mm_add_epi32(iv0, _mm_set1_epi32(1));
+                    if constexpr (kCompact)
+                    {
+                        storeTap(0, iu0, iv0);
+                        storeTap(1, iu1, iv0);
+                        storeTap(2, iu0, iv1);
+                        storeTap(3, iu1, iv1);
+                    }
+                    else
+                    {
+                        _mm_store_si128(reinterpret_cast<__m128i *>(U0), iu0);
+                        _mm_store_si128(reinterpret_cast<__m128i *>(V0), iv0);
+                        _mm_store_si128(reinterpret_cast<__m128i *>(U1), iu1);
+                        _mm_store_si128(reinterpret_cast<__m128i *>(V1), iv1);
+                    }
+                    _mm_store_ps(FX, _mm_sub_ps(su, _mm_cvtepi32_ps(iu0)));
+                    _mm_store_ps(FY, _mm_sub_ps(sv, _mm_cvtepi32_ps(iv0)));
+                }
+            }
+
+            while (mask != 0u)
+            {
+                const unsigned i = static_cast<unsigned>(std::countr_zero(mask));
+                mask &= mask - 1u;
+
+                uint8_t r, g, b, a;
+                if (iip)
+                {
+                    r = static_cast<uint8_t>(R[i]);
+                    g = static_cast<uint8_t>(G[i]);
+                    b = static_cast<uint8_t>(B[i]);
+                    a = static_cast<uint8_t>(A[i]);
+                }
+                else
+                {
+                    r = v2.r;
+                    g = v2.g;
+                    b = v2.b;
+                    a = v2.a;
+                }
+
+                if (tme)
+                {
+                    uint32_t texel;
+                    if constexpr (kCompact)
+                    {
+                        if (!linear)
+                        {
+                            texel = fetchTap(0, i);
+                        }
+                        else
+                        {
+                            // c00, c10, c01, c11: same order as SampleTextureFast.
+                            const uint32_t c00 = fetchTap(0, i);
+                            const uint32_t c10 = fetchTap(1, i);
+                            const uint32_t c01 = fetchTap(2, i);
+                            const uint32_t c11 = fetchTap(3, i);
+                            texel = bilinearBlend(c00, c10, c01, c11, FX[i], FY[i]);
+                        }
+                    }
+                    else if (!linear)
+                    {
+                        texel = SampleTexelFast<TexKind>(textureSetup, U0[i], V0[i]);
+                    }
+                    else
+                    {
+                        const uint32_t c00 = SampleTexelFast<TexKind>(textureSetup, U0[i], V0[i]);
+                        const uint32_t c10 = SampleTexelFast<TexKind>(textureSetup, U1[i], V0[i]);
+                        const uint32_t c01 = SampleTexelFast<TexKind>(textureSetup, U0[i], V1[i]);
+                        const uint32_t c11 = SampleTexelFast<TexKind>(textureSetup, U1[i], V1[i]);
+                        texel = bilinearBlend(c00, c10, c01, c11, FX[i], FY[i]);
+                    }
+
+                    const uint32_t color = combineTexturePacked(tex, r, g, b, a, texel);
+                    r = static_cast<uint8_t>(color);
+                    g = static_cast<uint8_t>(color >> 8);
+                    b = static_cast<uint8_t>(color >> 16);
+                    a = static_cast<uint8_t>(color >> 24);
+                }
+
+                const int px = x + static_cast<int>(i);
+                if (pixelSetup.simpleBlend)
+                {
+                    WritePixelSimpleBlend(pixelSetup, static_cast<u32>(Z[i] + 0.5), pack32(r, g, b, a),
+                                          pixelSetup.FbAddress(fbRow, pixelSetup.FbColumn(px)),
+                                          pixelSetup.ZAddress(zRow, pixelSetup.ZColumn(px)));
+                    continue;
+                }
+                WritePixelFast(pixelSetup, px, y, static_cast<u32>(Z[i] + 0.5), r, g, b, a, static_cast<uint8_t>(F[i]),
+                               pixelSetup.FbAddress(fbRow, pixelSetup.FbColumn(px)),
+                               pixelSetup.ZAddress(zRow, pixelSetup.ZColumn(px)));
+            }
+        }
+    }
+}
+
+void GSCpuBackend::DrawLine(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const auto &ctx = state.context;
+
+    int ofx = ctx.xyoffset.ofx >> 4;
+    int ofy = ctx.xyoffset.ofy >> 4;
+
+    int x0 = static_cast<int>(v0.x) - ofx;
+    int y0 = static_cast<int>(v0.y) - ofy;
+    int x1 = static_cast<int>(v1.x) - ofx;
+    int y1 = static_cast<int>(v1.y) - ofy;
+
+    int dx = std::abs(x1 - x0);
+    int dy = -std::abs(y1 - y0);
+    int sx = (x0 < x1) ? 1 : -1;
+    int sy = (y0 < y1) ? 1 : -1;
+    int err = dx + dy;
+
+    int totalSteps = std::max(std::abs(x1 - x0), std::abs(y1 - y0));
+    if (totalSteps == 0)
+        totalSteps = 1;
+    int step = 0;
+
+    for (;;)
+    {
+        float t = static_cast<float>(step) / static_cast<float>(totalSteps);
+        uint8_t r, g, b, a;
+        if (state.prim.iip)
+        {
+            r = clampU8(static_cast<int>(v0.r + (v1.r - v0.r) * t));
+            g = clampU8(static_cast<int>(v0.g + (v1.g - v0.g) * t));
+            b = clampU8(static_cast<int>(v0.b + (v1.b - v0.b) * t));
+            a = clampU8(static_cast<int>(v0.a + (v1.a - v0.a) * t));
+        }
+        else
+        {
+            r = v1.r;
+            g = v1.g;
+            b = v1.b;
+            a = v1.a;
+        }
+
+        double z = (v0.z + (v1.z - v0.z) * t);
+        const uint8_t fog = clampU8(static_cast<int>(v0.fog + (v1.fog - v0.fog) * t));
+        WritePixel(state, x0, y0, static_cast<u32>(z), r, g, b, a, fog);
+
+        if (x0 == x1 && y0 == y1)
+            break;
+
+        int e2 = 2 * err;
+        if (e2 >= dy)
+        {
+            err += dy;
+            x0 += sx;
+        }
+        if (e2 <= dx)
+        {
+            err += dx;
+            y0 += sy;
+        }
+        ++step;
+    }
+}
+
+void GSCpuBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (RecordingActive()) [[unlikely]]
+        RecordCall(kRecBeginTransfer, &command, sizeof(command));
+    if (m_featureStats) [[unlikely]]
+        m_featureStats->OnTransfer(command);
+    m_transfer = command;
+    m_transferState.x = command.trxpos.dsax;
+    m_transferState.y = command.trxpos.dsay;
+    m_transferState.totalPixels = static_cast<uint32_t>(command.trxreg.rrw) * static_cast<uint32_t>(command.trxreg.rrh);
+    m_transferState.copiedPixels = 0u;
+    m_transferState.direction = command.direction;
+    m_transferState.localToHostPendingBytes = 0u;
+
+    if (command.direction == 2u)
+        PerformLocalToLocalTransfer();
+    else if (command.direction == 1u)
+        PerformLocalToHostTransfer();
+}
+
+void GSCpuBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (RecordingActive() && data) [[unlikely]]
+        RecordCall(kRecUploadImage, data, sizeBytes);
+    if (!data || sizeBytes == 0u || !m_vram || m_transferState.direction != 0u)
+        return;
+    if (m_featureStats) [[unlikely]]
+        m_featureStats->OnUpload(sizeBytes);
+    if (m_transfer.trxreg.rrw == 0u || m_transfer.trxreg.rrh == 0u || m_transferState.totalPixels == 0u)
+        return;
+
+    const uint32_t dbp = m_transfer.bitbltbuf.dbp;
+    const uint32_t dbw = std::max<uint32_t>(m_transfer.bitbltbuf.dbw, 1u);
+    const uint8_t dpsm = m_transfer.bitbltbuf.dpsm;
+    const uint32_t rrw = m_transfer.trxreg.rrw;
+    const uint32_t dsax = m_transfer.trxpos.dsax;
+    uint32_t offset = 0u;
+
+    auto advancePixel = [&](uint32_t count)
+    {
+        const uint32_t totalPixels = m_transferState.totalPixels;
+        m_transferState.copiedPixels =
+            std::min<uint32_t>(totalPixels, m_transferState.copiedPixels + count);
+
+        if (m_transferState.copiedPixels >= totalPixels)
+        {
+            m_transferState.direction = 3u;
+            m_transferState.totalPixels = 0u;
+            return;
+        }
+
+        m_transferState.x = dsax + (m_transferState.copiedPixels % rrw);
+        m_transferState.y = m_transfer.trxpos.dsay + (m_transferState.copiedPixels / rrw);
+    };
+
+    while (offset < sizeBytes && m_transferState.direction == 0u)
+    {
+        switch (dpsm)
+        {
+        case GS_PSM_CT32:
+        case GS_PSM_Z32:
+        {
+            if (sizeBytes - offset < 4u)
+                return;
+            uint32_t value = 0u;
+            std::memcpy(&value, data + offset, sizeof(value));
+            WriteVramUnlocked(dpsm, dbp, dbw, m_transferState.x, m_transferState.y, value);
+            offset += 4u;
+            advancePixel(1u);
+            break;
+        }
+        case GS_PSM_CT24:
+        case GS_PSM_Z24:
+        {
+            if (sizeBytes - offset < 3u)
+                return;
+            const uint32_t value = static_cast<uint32_t>(data[offset]) |
+                                   (static_cast<uint32_t>(data[offset + 1u]) << 8u) |
+                                   (static_cast<uint32_t>(data[offset + 2u]) << 16u);
+            WriteVramUnlocked(dpsm, dbp, dbw, m_transferState.x, m_transferState.y, value);
+            offset += 3u;
+            advancePixel(1u);
+            break;
+        }
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+        {
+            if (sizeBytes - offset < 2u)
+                return;
+            uint16_t value = 0u;
+            std::memcpy(&value, data + offset, sizeof(value));
+            WriteVramUnlocked(dpsm, dbp, dbw, m_transferState.x, m_transferState.y, value);
+            offset += 2u;
+            advancePixel(1u);
+            break;
+        }
+        case GS_PSM_T8:
+        case GS_PSM_T8H:
+            WriteVramUnlocked(dpsm, dbp, dbw, m_transferState.x, m_transferState.y, data[offset++]);
+            advancePixel(1u);
+            break;
+        case GS_PSM_T4:
+        case GS_PSM_T4HL:
+        case GS_PSM_T4HH:
+        {
+            const uint8_t packed = data[offset++];
+            const uint32_t firstPixel = m_transferState.copiedPixels;
+            WriteVramUnlocked(dpsm, dbp, dbw,
+                              dsax + (firstPixel % rrw),
+                              m_transfer.trxpos.dsay + (firstPixel / rrw),
+                              packed & 0x0Fu);
+            if (firstPixel + 1u < m_transferState.totalPixels)
+            {
+                const uint32_t secondPixel = firstPixel + 1u;
+                WriteVramUnlocked(dpsm, dbp, dbw,
+                                  dsax + (secondPixel % rrw),
+                                  m_transfer.trxpos.dsay + (secondPixel / rrw),
+                                  (packed >> 4u) & 0x0Fu);
+            }
+            advancePixel(std::min<uint32_t>(2u, m_transferState.totalPixels - firstPixel));
+            break;
+        }
+        default:
+            return;
+        }
+    }
+}
+
+void GSCpuBackend::PerformLocalToLocalTransfer()
+{
+    if (!m_vram)
+        return;
+
+    const uint32_t rrw = m_transfer.trxreg.rrw;
+    const uint32_t rrh = m_transfer.trxreg.rrh;
+    const uint32_t total = rrw * rrh;
+    if (total == 0u)
+    {
+        m_transferState.direction = 3u;
+        return;
+    }
+
+    for (uint32_t pixel = 0; pixel < total; ++pixel)
+    {
+        uint32_t x = pixel % rrw;
+        uint32_t y = pixel / rrw;
+        if ((m_transfer.trxpos.dir & 0x2u) != 0u)
+            x = rrw - x - 1u;
+        if ((m_transfer.trxpos.dir & 0x1u) != 0u)
+            y = rrh - y - 1u;
+
+        const uint32_t value = ReadVramUnlocked(m_transfer.bitbltbuf.spsm,
+                                                m_transfer.bitbltbuf.sbp,
+                                                std::max<uint32_t>(m_transfer.bitbltbuf.sbw, 1u),
+                                                x + m_transfer.trxpos.ssax,
+                                                y + m_transfer.trxpos.ssay);
+        WriteVramUnlocked(m_transfer.bitbltbuf.dpsm,
+                          m_transfer.bitbltbuf.dbp,
+                          std::max<uint32_t>(m_transfer.bitbltbuf.dbw, 1u),
+                          x + m_transfer.trxpos.dsax,
+                          y + m_transfer.trxpos.dsay,
+                          value);
+    }
+
+    m_transferState.copiedPixels = total;
+    m_transferState.direction = 3u;
+}
+
+void GSCpuBackend::PerformLocalToHostTransfer()
+{
+    m_localToHostBuffer.clear();
+    m_localToHostReadPos = 0u;
+    if (!m_vram)
+        return;
+
+    const uint32_t rrw = m_transfer.trxreg.rrw;
+    const uint32_t rrh = m_transfer.trxreg.rrh;
+    const uint32_t sbw = std::max<uint32_t>(m_transfer.bitbltbuf.sbw, 1u);
+    const uint8_t spsm = m_transfer.bitbltbuf.spsm;
+    const uint32_t bpp = static_cast<uint32_t>(GSMem::BitsPerPixel(static_cast<GSMem::PixelStorageMode>(spsm)));
+    const uint32_t total = rrw * rrh;
+    m_localToHostBuffer.reserve((static_cast<size_t>(total) * bpp + 7u) / 8u);
+
+    for (uint32_t pixel = 0u; pixel < total; ++pixel)
+    {
+        const uint32_t x = pixel % rrw;
+        const uint32_t y = pixel / rrw;
+        const uint32_t value = ReadVramUnlocked(spsm,
+                                                m_transfer.bitbltbuf.sbp,
+                                                sbw,
+                                                x + m_transfer.trxpos.ssax,
+                                                y + m_transfer.trxpos.ssay);
+        switch (bpp)
+        {
+        case 32:
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 8u));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 16u));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 24u));
+            break;
+        case 24:
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 8u));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 16u));
+            break;
+        case 16:
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 8u));
+            break;
+        case 8:
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value));
+            break;
+        case 4:
+        {
+            if ((pixel & 1u) != 0u)
+                break;
+            uint32_t next = 0u;
+            if (pixel + 1u < total)
+            {
+                const uint32_t nextPixel = pixel + 1u;
+                const uint32_t nextX = nextPixel % rrw;
+                const uint32_t nextY = nextPixel / rrw;
+                next = ReadVramUnlocked(spsm, m_transfer.bitbltbuf.sbp, sbw,
+                                        nextX + m_transfer.trxpos.ssax,
+                                        nextY + m_transfer.trxpos.ssay);
+            }
+            m_localToHostBuffer.push_back(static_cast<uint8_t>((value & 0x0Fu) | ((next & 0x0Fu) << 4u)));
+            break;
+        }
+        default:
+            break;
+        }
+    }
+
+    m_transferState.copiedPixels = total;
+    m_transferState.localToHostPendingBytes = m_localToHostBuffer.size();
+}
+
+uint32_t GSCpuBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (RecordingActive()) [[unlikely]]
+        RecordCall(kRecConsumeLocalToHost, &maxBytes, sizeof(maxBytes));
+    if (!dst || maxBytes == 0u || m_localToHostReadPos >= m_localToHostBuffer.size())
+        return 0u;
+    const size_t count = std::min<size_t>(maxBytes, m_localToHostBuffer.size() - m_localToHostReadPos);
+    std::memcpy(dst, m_localToHostBuffer.data() + m_localToHostReadPos, count);
+    m_localToHostReadPos += count;
+    m_transferState.localToHostPendingBytes = m_localToHostBuffer.size() - m_localToHostReadPos;
+    if (m_featureStats) [[unlikely]]
+        m_featureStats->OnLocalToHostRead(static_cast<uint32_t>(count));
+    return static_cast<uint32_t>(count);
+}
+
+bool GSCpuBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (RecordingActive()) [[unlikely]]
+        RecordCall(kRecClearFramebuffer, &context, sizeof(context), &rgba, sizeof(rgba));
+    if (!m_vram || context.frame.fbw == 0u)
+        return false;
+
+    const uint32_t x0 = context.scissor.x0;
+    const uint32_t x1 = std::max<uint32_t>(x0, context.scissor.x1);
+    const uint32_t y0 = context.scissor.y0;
+    const uint32_t y1 = std::max<uint32_t>(y0, context.scissor.y1);
+    uint8_t r = static_cast<uint8_t>(rgba);
+    uint8_t g = static_cast<uint8_t>(rgba >> 8u);
+    uint8_t b = static_cast<uint8_t>(rgba >> 16u);
+    uint8_t a = static_cast<uint8_t>(rgba >> 24u);
+    if ((context.fba & 1ull) != 0ull && context.frame.psm != GS_PSM_CT24)
+        a |= 0x80u;
+
+    const uint32_t fbp = GSInternal::framePageBaseToBlock(context.frame.fbp);
+    const uint32_t fbw = std::max<uint32_t>(context.frame.fbw, 1u);
+    if (context.frame.psm == GS_PSM_CT32 || context.frame.psm == GS_PSM_CT24)
+    {
+        const uint32_t source = static_cast<uint32_t>(r) |
+                                (static_cast<uint32_t>(g) << 8u) |
+                                (static_cast<uint32_t>(b) << 16u) |
+                                (static_cast<uint32_t>(a) << 24u);
+        for (uint32_t y = y0; y <= y1; ++y)
+            for (uint32_t x = x0; x <= x1; ++x)
+            {
+                uint32_t pixel = source;
+                if (context.frame.fbmsk != 0u)
+                {
+                    const uint32_t old = ReadVramUnlocked(context.frame.psm, fbp, fbw, x, y);
+                    pixel = (pixel & ~context.frame.fbmsk) | (old & context.frame.fbmsk);
+                }
+                WriteVramUnlocked(context.frame.psm, fbp, fbw, x, y, pixel);
+            }
+        return true;
+    }
+
+    if (context.frame.psm == GS_PSM_CT16 || context.frame.psm == GS_PSM_CT16S)
+    {
+        const uint16_t source = encodeFramePixelPSMCT16(r, g, b, a);
+        const uint16_t mask = static_cast<uint16_t>(context.frame.fbmsk);
+        for (uint32_t y = y0; y <= y1; ++y)
+            for (uint32_t x = x0; x <= x1; ++x)
+            {
+                uint16_t pixel = source;
+                if (mask != 0u)
+                {
+                    const uint16_t old = static_cast<uint16_t>(ReadVramUnlocked(context.frame.psm, fbp, fbw, x, y));
+                    pixel = static_cast<uint16_t>((pixel & ~mask) | (old & mask));
+                }
+                WriteVramUnlocked(context.frame.psm, fbp, fbw, x, y, pixel);
+            }
+        return true;
+    }
+    return false;
+}
+
+bool GSCpuBackend::CopyFrameToHostRgba(const GSFrameReg &frame,
+                                       uint32_t width,
+                                       uint32_t height,
+                                       std::vector<uint8_t> &outPixels,
+                                       bool preserveAlpha,
+                                       bool useLocalMemoryLayout,
+                                       bool frameBaseIsPages,
+                                       uint32_t sourceOriginX,
+                                       uint32_t sourceOriginY) const
+{
+    if (!m_vram || m_vramSize == 0u)
+        return false;
+
+    outPixels.assign(kHostFrameWidth * kHostFrameHeight * 4u, 0u);
+    const uint32_t baseBytes = frameBaseIsPages ? frame.fbp * 8192u : frame.fbp * 256u;
+    const uint32_t basePtr = frameBaseIsPages ? GSInternal::framePageBaseToBlock(frame.fbp) : frame.fbp;
+    const uint32_t fbw = frame.fbw ? frame.fbw : kHostFrameWidth / 64u;
+    const uint32_t bytesPerPixel = (frame.psm == GS_PSM_CT16 || frame.psm == GS_PSM_CT16S) ? 2u : 4u;
+    const uint32_t stride = fbw * 64u * bytesPerPixel;
+
+    for (uint32_t y = 0; y < height; ++y)
+    {
+        uint8_t *dst = outPixels.data() + y * kHostFrameWidth * 4u;
+        for (uint32_t x = 0; x < width; ++x)
+        {
+            const uint32_t sx = sourceOriginX + x;
+            const uint32_t sy = sourceOriginY + y;
+            if (frame.psm == GS_PSM_CT32 || frame.psm == GS_PSM_CT24)
+            {
+                uint32_t color = 0u;
+                if (useLocalMemoryLayout)
+                    color = ReadVramUnlocked(frame.psm, basePtr, fbw, sx, sy);
+                else
+                {
+                    const uint32_t pixelBytes = frame.psm == GS_PSM_CT24 ? 3u : 4u;
+                    const uint64_t offset = static_cast<uint64_t>(baseBytes) + static_cast<uint64_t>(sy) * stride + static_cast<uint64_t>(sx) * pixelBytes;
+                    if (offset + pixelBytes > m_vramSize)
+                        return false;
+                    color = m_vram[offset] | (static_cast<uint32_t>(m_vram[offset + 1u]) << 8u) |
+                            (static_cast<uint32_t>(m_vram[offset + 2u]) << 16u);
+                    if (pixelBytes == 4u)
+                        color |= static_cast<uint32_t>(m_vram[offset + 3u]) << 24u;
+                }
+                dst[x * 4u] = static_cast<uint8_t>(color);
+                dst[x * 4u + 1u] = static_cast<uint8_t>(color >> 8u);
+                dst[x * 4u + 2u] = static_cast<uint8_t>(color >> 16u);
+                dst[x * 4u + 3u] = preserveAlpha && frame.psm != GS_PSM_CT24 ? static_cast<uint8_t>(color >> 24u) : 255u;
+            }
+            else if (frame.psm == GS_PSM_CT16 || frame.psm == GS_PSM_CT16S)
+            {
+                uint16_t color = 0u;
+                if (useLocalMemoryLayout)
+                    color = static_cast<uint16_t>(ReadVramUnlocked(frame.psm, basePtr, fbw, sx, sy));
+                else
+                {
+                    const uint64_t offset = static_cast<uint64_t>(baseBytes) + static_cast<uint64_t>(sy) * stride + static_cast<uint64_t>(sx) * 2u;
+                    if (offset + 2u > m_vramSize)
+                        return false;
+                    std::memcpy(&color, m_vram + offset, sizeof(color));
+                }
+                const uint32_t r = color & 31u;
+                const uint32_t g = (color >> 5u) & 31u;
+                const uint32_t b = (color >> 10u) & 31u;
+                dst[x * 4u] = static_cast<uint8_t>((r << 3u) | (r >> 2u));
+                dst[x * 4u + 1u] = static_cast<uint8_t>((g << 3u) | (g >> 2u));
+                dst[x * 4u + 2u] = static_cast<uint8_t>((b << 3u) | (b >> 2u));
+                dst[x * 4u + 3u] = preserveAlpha ? ((color & 0x8000u) ? 0x80u : 0u) : 255u;
+            }
+            else
+            {
+                outPixels.clear();
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+PresentationFrame GSCpuBackend::Present(const GSPresentationRequest &request)
+{
+    // Snapshot local memory under the backend lock, then perform the expensive
+    // display conversion without holding the producer-side raster lock.
+    if (m_featureStats) [[unlikely]]
+        ReportFeatureStatsOnPresent();
+    if (m_recorder) [[unlikely]]
+        RecorderOnPresent(request.vsyncTick);
+    thread_local std::vector<uint8_t> snapshot;
+    SnapshotVram(snapshot);
+    if (snapshot.empty())
+        return {};
+
+    thread_local GSCpuBackend snapshotBackend;
+    snapshotBackend.Initialize(snapshot.data(), static_cast<uint32_t>(snapshot.size()));
+    return snapshotBackend.PresentFromLocalMemory(request);
+}
+
+PresentationFrame GSCpuBackend::PresentFromLocalMemory(const GSPresentationRequest &request)
+{
+    PresentationFrame result{};
+    const GSPmodeState pmode = decodePmode(request.pmode);
+    const GSSmode2State smode2 = decodeSMode2(request.smode2);
+    const bool fieldMode = smode2.interlaced && !smode2.frameMode;
+    const bool oddField = (request.vsyncTick & 1ull) != 0ull;
+    const GSFrameReg displayFrame1 = decodeDisplayFrame(request.dispfb1);
+    const GSFrameReg displayFrame2 = decodeDisplayFrame(request.dispfb2);
+    const GSDisplayReadOrigin origin1 = decodeDisplayReadOrigin(request.dispfb1);
+    const GSDisplayReadOrigin origin2 = decodeDisplayReadOrigin(request.dispfb2);
+    uint32_t width1 = 0u, height1 = 0u, width2 = 0u, height2 = 0u;
+    decodeDisplaySize(request.display1, width1, height1);
+    decodeDisplaySize(request.display2, width2, height2);
+    const bool valid1 = pmode.enableCrt1 && hasDisplaySetup(request.display1, displayFrame1);
+    const bool valid2 = pmode.enableCrt2 && hasDisplaySetup(request.display2, displayFrame2);
+    if (!valid1 && !valid2)
+        return result;
+
+    auto copySource = [&](const GSFrameReg &displayFrame,
+                          const GSDisplayReadOrigin &origin,
+                          uint32_t width,
+                          uint32_t height,
+                          bool allowPreferred,
+                          bool preserveAlpha,
+                          GSFrameReg &selected,
+                          std::vector<uint8_t> &pixels,
+                          bool &usedPreferred) -> bool
+    {
+        selected = displayFrame;
+        pixels.clear();
+        usedPreferred = false;
+        if (allowPreferred && request.hasPreferredSource && request.preferredDestFbp == displayFrame.fbp &&
+            (request.preferredSource.fbw != 0u || request.preferredSource.fbp != displayFrame.fbp) &&
+            CopyFrameToHostRgba(request.preferredSource, width, height, pixels, preserveAlpha, true, false, 0u, 0u))
+        {
+            selected = request.preferredSource;
+            usedPreferred = true;
+        }
+        if (pixels.empty() && !CopyFrameToHostRgba(displayFrame, width, height, pixels, preserveAlpha, true, true, origin.x, origin.y))
+            return false;
+
+        if (!usedPreferred && displayFrame.fbp == 0u && countNonBlackPixels(pixels, width, height) == 0u)
+        {
+            for (const GSFrameReg &candidate : request.contextFrames)
+            {
+                if (candidate.fbp == selected.fbp && candidate.fbw == selected.fbw && candidate.psm == selected.psm)
+                    continue;
+                std::vector<uint8_t> candidatePixels;
+                if (!CopyFrameToHostRgba(candidate, width, height, candidatePixels, preserveAlpha, true, true, 0u, 0u))
+                    continue;
+                if (countNonBlackPixels(candidatePixels, width, height) == 0u)
+                    continue;
+                selected = candidate;
+                pixels.swap(candidatePixels);
+                break;
+            }
+        }
+        return true;
+    };
+
+    if (valid1 && valid2)
+    {
+        GSFrameReg selected1{}, selected2{};
+        std::vector<uint8_t> crt1, crt2;
+        bool preferred1 = false, preferred2 = false;
+        if (copySource(displayFrame1, origin1, width1, height1, false, true, selected1, crt1, preferred1) &&
+            copySource(displayFrame2, origin2, width2, height2, false, true, selected2, crt2, preferred2))
+        {
+            result.width = std::max(width1, width2);
+            result.height = std::max(height1, height2);
+            result.pixels.assign(kHostFrameWidth * kHostFrameHeight * 4u, 0u);
+            const uint8_t bgR = static_cast<uint8_t>(request.bgcolor);
+            const uint8_t bgG = static_cast<uint8_t>(request.bgcolor >> 8u);
+            const uint8_t bgB = static_cast<uint8_t>(request.bgcolor >> 16u);
+            for (uint32_t y = 0; y < result.height; ++y)
+                for (uint32_t x = 0; x < result.width; ++x)
+                {
+                    uint8_t *dst = result.pixels.data() + (y * kHostFrameWidth + x) * 4u;
+                    dst[0] = bgR;
+                    dst[1] = bgG;
+                    dst[2] = bgB;
+                    dst[3] = pmode.alp;
+                }
+            if (!pmode.slbg)
+                for (uint32_t y = 0; y < height2; ++y)
+                    std::memcpy(result.pixels.data() + y * kHostFrameWidth * 4u, crt2.data() + y * kHostFrameWidth * 4u, width2 * 4u);
+            for (uint32_t y = 0; y < height1; ++y)
+                for (uint32_t x = 0; x < width1; ++x)
+                {
+                    const uint8_t *src = crt1.data() + (y * kHostFrameWidth + x) * 4u;
+                    uint8_t *dst = result.pixels.data() + (y * kHostFrameWidth + x) * 4u;
+                    const uint32_t factor = pmode.mmod ? pmode.alp : std::min<uint32_t>(255u, static_cast<uint32_t>(src[3]) * 2u);
+                    dst[0] = blendPresentationChannel(src[0], dst[0], factor);
+                    dst[1] = blendPresentationChannel(src[1], dst[1], factor);
+                    dst[2] = blendPresentationChannel(src[2], dst[2], factor);
+                    dst[3] = pmode.amod ? dst[3] : src[3];
+                }
+            normalizePresentationAlpha(result.pixels, result.width, result.height);
+            if (fieldMode)
+                applyFieldPresentation(result.pixels, result.width, result.height, oddField);
+            result.displayFbp = displayFrame1.fbp;
+            result.sourceFbp = selected1.fbp;
+            return result;
+        }
+    }
+
+    const GSFrameReg &displayFrame = valid1 ? displayFrame1 : displayFrame2;
+    const GSDisplayReadOrigin &origin = valid1 ? origin1 : origin2;
+    result.width = valid1 ? width1 : width2;
+    result.height = valid1 ? height1 : height2;
+    GSFrameReg selected = displayFrame;
+    if (!copySource(displayFrame, origin, result.width, result.height, true, false, selected, result.pixels, result.usedPreferred))
+        return {};
+    if (fieldMode)
+        applyFieldPresentation(result.pixels, result.width, result.height, oddField);
+    normalizePresentationAlpha(result.pixels, result.width, result.height);
+    result.displayFbp = displayFrame.fbp;
+    result.sourceFbp = selected.fbp;
+    return result;
+}
