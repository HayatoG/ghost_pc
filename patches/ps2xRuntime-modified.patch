+// PS2X_MISSING_LOG: appends one line per *unique* missing branch target ("0xTARGET kind source=0xSRC").
+// The full diagnostic dump below only covers the first miss, which forces one rebuild per address; this
+// list lets every uncovered function start be fixed in a single pass (see tools/ghidra/CreateFunctionsAt.java).
+static void recordMissingTarget(uint32_t targetPc, uint32_t sourcePc, const char *kindName)
+{
+    static std::mutex mutex;
+    static std::unordered_map<uint32_t, uint64_t> seen;
+    static const std::string path = envString("PS2X_MISSING_LOG");
+
+    std::lock_guard<std::mutex> lock(mutex);
+    const bool isNew = ++seen[targetPc] == 1u;
+    if (!isNew || path.empty())
+    {
+        return;
+    }
+
+    std::ofstream out(path, std::ios::app);
+    if (out)
+    {
+        out << "0x" << std::hex << targetPc << std::dec << ' ' << kindName << " source=0x" << std::hex << sourcePc
+            << std::dec << '\n';
+    }
+}
