+    GS_FORCEINLINE int wrapTextureCoordinate(int coordinate,
+                              int textureSize,
+                              uint8_t mode,
+                              uint16_t regionMin,
+                              uint16_t regionMax)
+    {
+        switch (mode & 0x3u)
+        {
+        case 0: // REPEAT
+            return static_cast<int>(static_cast<uint32_t>(coordinate) & static_cast<uint32_t>(textureSize - 1));
+        case 1: // CLAMP
+            return clampInt(coordinate, 0, textureSize - 1);
+        case 2: // REGION_CLAMP
