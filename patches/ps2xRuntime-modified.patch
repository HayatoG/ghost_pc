 function(EnableFastReleaseMode TargetName)
     message("> Enabling optimization for: ${TargetName}")
+
+    # Whole-program optimization moves most of the code generation into the (mostly serial) link step.
+    # PS2X_ENABLE_LTCG=OFF keeps /O2 but compiles in parallel and links quickly (dev/perf iteration builds).
+    set(PS2X_GL_FLAG "")
+    set(PS2X_LTCG_FLAG "")
+    if(PS2X_ENABLE_LTCG)
+        set(PS2X_GL_FLAG /GL)
+        set(PS2X_LTCG_FLAG /LTCG)
+    endif()
+
     if(MSVC)
         target_compile_options(${TargetName} PRIVATE
             $<$<CONFIG:Release>:
                 /O2 # speed
                 /Ob2 # inline aggressively
                 /Oi # intrinsics
-                /GL # whole program opt
+                ${PS2X_GL_FLAG} # whole program opt
                 /Gy # function-level linking
                 /Gw # global data in COMDAT
                 /GF # string pooling
@@ -26,7 +36,7 @@ function(EnableFastReleaseMode TargetName)
