-                return result;
-            }
-
-            const uint8_t marker = packet[pos] & 0xF0u;
-            if (marker == 0x20u && pos + 5u <= packetSize)
-            {
-                result.pts90k = decodePesTimestamp90k(packet + pos, packetSize - pos);
-                pos += 5u;
-            }
