+# Per-title overrides register themselves from a static initializer. Inside the static ps2_runtime library the
+# linker drops an object nothing references, so the title module is compiled straight into the executable
+# (and kept out of the unity batches so editing it rebuilds only itself).
+target_sources(ps2EntryRunner PRIVATE src/lib/ghost_overrides.cpp)
+set_source_files_properties(src/lib/ghost_overrides.cpp PROPERTIES SKIP_UNITY_BUILD_INCLUSION TRUE)
