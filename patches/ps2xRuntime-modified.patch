-uint32_t PS2Runtime::normalizeGuestHeapAlignment(uint32_t alignment)
-{
-    if (!isGuestHeapAlignmentValid(alignment))
-    {
-        return kGuestHeapDefaultAlignment;
-    }
-    return std::max(alignment, kGuestHeapDefaultAlignment);
-}
