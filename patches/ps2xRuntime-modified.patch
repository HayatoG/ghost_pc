+# Every guest call is a nested native C++ call, so a deep guest call chain needs a deep host stack.
+# The Windows default (1 MB) overflowed (0xC00000FD) in generated code. /STACK sets the reserved size of the
+# main thread and of every thread created with the default size (e.g. std::thread). Only address space is
+# reserved; pages are committed on demand.
+set(PS2X_STACK_RESERVE_MB 256 CACHE STRING "Reserved host stack per thread, in MB (MSVC)")
+if(MSVC)
+    math(EXPR PS2X_STACK_RESERVE_BYTES "${PS2X_STACK_RESERVE_MB} * 1024 * 1024")
+    target_link_options(ps2EntryRunner PRIVATE "/STACK:${PS2X_STACK_RESERVE_BYTES}")
+endif()
+
 # Vita: Work around for GCC 10's LTO plugin
 if(PS2X_IS_VITA)
     target_link_options(ps2EntryRunner PRIVATE "-Wl,--allow-multiple-definition")
