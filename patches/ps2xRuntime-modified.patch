-            {
-                result.pts90k = decodePesTimestamp90k(packet + pos, packetSize - pos);
-                result.dts90k = decodePesTimestamp90k(packet + pos + 5u, packetSize - pos - 5u);
-                pos += 10u;
-            }
-            else if (packet[pos] == 0x0Fu)
-            {
-                ++pos;
-            }
