+// DMA addresses are physical, so the VU memories are reachable at their EE map: games use this to fetch VU0 output.
+static uint8_t *resolveVuDmaMemory(uint32_t address, uint32_t byteCount, uint8_t *vu0Code, uint8_t *vu0Data, uint8_t *vu1Code,
+                                   uint8_t *vu1Data)
+{
+    struct Region
+    {
+        uint32_t base;
+        uint32_t size;
+        uint8_t *memory;
+    };
+    const Region regions[] = {
+        {0x11000000u, PS2_VU0_CODE_SIZE, vu0Code},
+        {0x11004000u, PS2_VU0_DATA_SIZE, vu0Data},
+        {0x11008000u, PS2_VU1_CODE_SIZE, vu1Code},
+        {0x1100C000u, PS2_VU1_DATA_SIZE, vu1Data},
+    };
+    for (const Region &region : regions)
+    {
+        if (region.memory != nullptr && address >= region.base && address - region.base < region.size &&
+            byteCount <= region.size - (address - region.base))
+        {
+            return region.memory + (address - region.base);
+        }
+    }
+    return nullptr;
+}
