+    void sceMpegAddBs(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t mpegAddr = getRegU32(ctx, 4);
+        const uint32_t dataAddr = getRegU32(ctx, 5);
+        const uint32_t byteCount = getRegU32(ctx, 6);
