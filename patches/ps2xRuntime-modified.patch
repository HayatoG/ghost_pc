-        const uint8_t atst = static_cast<uint8_t>((testReg >> 1) & 0x7u);
-        const uint8_t aref = static_cast<uint8_t>((testReg >> 4) & 0xFFu);
-
-        switch (atst)
-        {
-        case 0:
-            return false;
-        case 1:
-            return true;
-        case 2:
-            return alpha < aref;
-        case 3:
-            return alpha <= aref;
-        case 4:
-            return alpha == aref;
-        case 5:
-            return alpha >= aref;
-        case 6:
-            return alpha > aref;
-        case 7:
-            return alpha != aref;
-        default:
-            return true;
-        }
