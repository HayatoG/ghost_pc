+void VU1Interpreter::applyDest(float *dst, const float *result, uint8_t dest)
+{
+    if (dest & 0x8u)
+        dst[0] = result[0];
+    if (dest & 0x4u)
+        dst[1] = result[1];
+    if (dest & 0x2u)
+        dst[2] = result[2];
+    if (dest & 0x1u)
+        dst[3] = result[3];
+}
