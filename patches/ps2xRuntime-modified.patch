+GSPrimitiveBatch GS::buildDrawBatch(int vertexCount) const
+{
+    GSPrimitiveBatch batch{};
+    batch.vertexCount = static_cast<uint8_t>(std::min(vertexCount, 3));
+    for (int i = 0; i < batch.vertexCount; ++i)
+        batch.vertices[static_cast<size_t>(i)] = m_vtxQueue[i];
+    batch.state.context = m_ctx[m_prim.ctxt ? 1 : 0];
+    batch.state.prim = m_prim;
+    batch.state.texa = m_texa;
+    batch.state.texclut = m_texclut;
+    batch.state.pabe = m_pabe;
+    batch.state.scanmsk = m_scanmsk;
+    batch.state.dimx = m_dimx;
+    batch.state.dthe = m_dthe;
+    batch.state.colclamp = m_colclamp;
+    batch.state.fogR = m_fogR;
+    batch.state.fogG = m_fogG;
+    batch.state.fogB = m_fogB;
+    batch.state.textureWidth = static_cast<uint16_t>(1u << std::min<uint32_t>(batch.state.context.tex0.tw, 10u));
+    batch.state.textureHeight = static_cast<uint16_t>(1u << std::min<uint32_t>(batch.state.context.tex0.th, 10u));
+    const uint64_t tex1 = batch.state.context.tex1;
+    const uint8_t mmag = static_cast<uint8_t>((tex1 >> 5u) & 0x1u);
+    const uint8_t mmin = static_cast<uint8_t>((tex1 >> 6u) & 0x7u);
+    batch.state.linearFilter = mmag != 0u || mmin == 1u || (mmin & 0x4u) != 0u;
+    return batch;
+}
+
+// Set while the PS2X_GS_DUMP_VSYNC window is open; other tracers (VIF, VU1) use it to log only that window.
+std::atomic<bool> g_ps2TraceWindow{false};
+
+namespace
+{
+    // PS2X_GS_DUMP_VSYNC=N [PS2X_GS_DUMP_OUT=file]: from guest vsync N on, writes up to kDumpDraws draws as text
+    // (primitive, targets, texture, tests and vertices), to tell broken geometry from broken GS state.
+    void dumpDrawIfRequested(const GSPrimitiveBatch &batch, uint64_t vsync)
+    {
+        constexpr int kDumpDraws = 20000;
+        static const char *const startText = std::getenv("PS2X_GS_DUMP_VSYNC");
+        if (startText == nullptr)
+        {
+            return;
+        }
+        static const uint64_t start = std::strtoull(startText, nullptr, 10);
+        static int written = 0;
+        if (vsync < start || written >= kDumpDraws)
+        {
+            g_ps2TraceWindow.store(false, std::memory_order_relaxed);
+            return;
+        }
+        g_ps2TraceWindow.store(true, std::memory_order_relaxed);
+        std::FILE *const file = gsDumpFile();
+        if (file == nullptr)
+        {
+            return;
+        }
+        ++written;
+        const GSDrawState &state = batch.state;
+        const GSContext &ctx = state.context;
+        std::fprintf(file, "D vs=%llu prim=%d tme=%d abe=%d iip=%d fst=%d fge=%d ctxt=%d fbp=%x fbw=%u fpsm=%x fbmsk=%x zbp=%x test=%llx alpha=%llx tbp=%x tpsm=%x tw=%u th=%u tfx=%u ofx=%d ofy=%d",
+                     static_cast<unsigned long long>(vsync), static_cast<int>(state.prim.type), state.prim.tme, state.prim.abe, state.prim.iip,
+                     state.prim.fst, state.prim.fge, state.prim.ctxt, ctx.frame.fbp, ctx.frame.fbw, ctx.frame.psm, ctx.frame.fbmsk, ctx.zbuf.zbp,
+                     static_cast<unsigned long long>(ctx.test), static_cast<unsigned long long>(ctx.alpha), ctx.tex0.tbp0, ctx.tex0.psm, ctx.tex0.tw,
+                     ctx.tex0.th, ctx.tex0.tfx, static_cast<int>(ctx.xyoffset.ofx), static_cast<int>(ctx.xyoffset.ofy));
+        for (int index = 0; index < batch.vertexCount; ++index)
+        {
+            const GSVertex &v = batch.vertices[index];
+            std::fprintf(file, " | x=%.2f y=%.2f z=%.0f c=%02x%02x%02x%02x s=%.4f t=%.4f q=%.4f u=%u v=%u", v.x, v.y, v.z, v.r, v.g, v.b, v.a, v.s, v.t, v.q, v.u, v.v);
+        }
+        std::fputc('\n', file);
+        if (written == kDumpDraws)
+        {
+            std::fclose(file);
+        }
+    }
+}
+
+void GS::tracePixelsIfRequested()
+{
+    // PS2X_GS_TRACE_PX="fbp:x,y;fbp:x,y" [PS2X_GS_TRACE_PX_OUT=file]: while the PS2X_GS_DUMP_VSYNC window is open, logs
+    // each watched CT32 pixel that changed. Runs before the current batch is submitted, so draw N-1 (1-based line of
+    // the draw dump) is the one that painted it.
+    struct WatchedPixel
+    {
+        uint32_t fbp, x, y, last;
+    };
+    static std::vector<WatchedPixel> pixels = []()
+    {
+        std::vector<WatchedPixel> parsed;
+        const char *cursor = std::getenv("PS2X_GS_TRACE_PX");
+        unsigned fbp = 0, x = 0, y = 0;
+        int consumed = 0;
+        while (cursor != nullptr && std::sscanf(cursor, "%x:%u,%u;%n", &fbp, &x, &y, &consumed) >= 3 && consumed > 0)
+        {
+            parsed.push_back({fbp, x, y, 0u});
+            cursor += consumed;
+            consumed = 0;
+        }
+        return parsed;
+    }();
+    if (pixels.empty() || !m_backend || !g_ps2TraceWindow.load(std::memory_order_relaxed))
+    {
+        return;
+    }
+    static std::FILE *const file = []()
+    {
+        const char *path = std::getenv("PS2X_GS_TRACE_PX_OUT");
+        return std::fopen(path ? path : "gs_px.txt", "w");
+    }();
+    if (file == nullptr)
+    {
+        return;
+    }
+    static uint32_t draw = 0;
+    ++draw;
+    m_backend->Flush();
+    m_backend->Sync(GSSyncReason::DebugReadback);
+    for (WatchedPixel &pixel : pixels)
+    {
+        const uint32_t value = GSMem::ReadCT32(m_localMemoryStorage, pixel.fbp * 32u, 10u, pixel.x, pixel.y);
+        if (value != pixel.last)
+        {
+            std::fprintf(file, "P after_draw=%u fbp=%x x=%u y=%u %08x -> %08x\n", draw - 1u, pixel.fbp, pixel.x, pixel.y,
+                         pixel.last, value);
+            pixel.last = value;
+        }
+    }
+    std::fflush(file);
+}
+
+void GS::updatePreferredDisplaySourceForDraw(const GSPrimitiveBatch &batch)
+{
+    dumpDrawIfRequested(batch, m_privRegs ? m_privRegs->vsyncTick.load(std::memory_order_acquire) : 0u);
+    tracePixelsIfRequested();
+    const GSDrawState &state = batch.state;
+    const GSContext &ctx = state.context;
+    if (m_hasPreferredDisplaySource && ctx.frame.fbp == m_preferredDisplayDestFbp)
+        m_hasPreferredDisplaySource = false;
+    if (state.prim.type != GS_PRIM_SPRITE || batch.vertexCount < 2u)
+        return;
+
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    int x0 = static_cast<int>(v0.x) - (ctx.xyoffset.ofx >> 4);
+    int y0 = static_cast<int>(v0.y) - (ctx.xyoffset.ofy >> 4);
+    int x1 = static_cast<int>(v1.x) - (ctx.xyoffset.ofx >> 4);
+    int y1 = static_cast<int>(v1.y) - (ctx.xyoffset.ofy >> 4);
+    if (x0 > x1) std::swap(x0, x1);
+    if (y0 > y1) std::swap(y0, y1);
+    const int xEnd = x0 + std::max(1, x1 - x0) - 1;
+    const int yEnd = y0 + std::max(1, y1 - y0) - 1;
+    const uint8_t alphaMode = static_cast<uint8_t>(ctx.alpha & 0xFFu);
+    const uint8_t alphaFix = static_cast<uint8_t>((ctx.alpha >> 32u) & 0xFFu);
+    const bool displayCopy = state.prim.tme && state.prim.abe && state.prim.fst && state.prim.ctxt &&
+                             ctx.frame.fbp != ctx.tex0.tbp0 && alphaMode == 0x64u &&
+                             (alphaFix == 0x60u || alphaFix == 0x80u) &&
+                             x0 <= 0 && y0 <= 0 && xEnd >= 639 && yEnd >= 447;
+    if (displayCopy)
+    {
+        m_preferredDisplaySourceFrame = {ctx.tex0.tbp0, ctx.tex0.tbw, ctx.tex0.psm, 0u};
+        m_preferredDisplayDestFbp = ctx.frame.fbp;
+        m_hasPreferredDisplaySource = true;
+    }
+}
