+if(CMAKE_BUILD_TYPE STREQUAL "Release" OR CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
+    EnableFastReleaseMode(ps2_runtime)
+    if(MSVC AND PS2X_RUNNER_OPT STREQUAL "dev")
+        # Iteration build: the generated code is compiled without optimization (backend cost drops ~10x on the
+        # heavy batches). Guest code runs slower and uses bigger host frames. Do not measure FPS with this tree.
+        message(STATUS "ps2EntryRunner: PS2X_RUNNER_OPT=dev (/Od) - iteration only")
+        target_compile_options(ps2EntryRunner PRIVATE $<$<CONFIG:Release>:/Od /Ob0 /Zc:inline /fp:fast /arch:AVX2 /GS- /Qspectre->)
+    else()
+        EnableFastReleaseMode(ps2EntryRunner)
+    endif()
+
+    if(WIN32 AND NOT PS2X_SHOW_WINDOWS_CONSOLE)
+        if(MSVC)
+            target_link_options(ps2EntryRunner PRIVATE
+                $<$<OR:$<CONFIG:Release>,$<CONFIG:RelWithDebInfo>>:/SUBSYSTEM:WINDOWS>
+                $<$<OR:$<CONFIG:Release>,$<CONFIG:RelWithDebInfo>>:/ENTRY:mainCRTStartup>
+            )
+        elseif(MINGW)
+            target_link_options(ps2EntryRunner PRIVATE
+                $<$<OR:$<CONFIG:Release>,$<CONFIG:RelWithDebInfo>>:-mwindows>
+            )
+        endif()
+    endif()
+endif()
+
+# Work around WinAPI vs raylib symbol clash for CloseWindow on x64
+if(MSVC)
+    target_link_options(ps2EntryRunner PRIVATE "/FORCE:MULTIPLE")
+endif()
+
+# Every guest call is a nested native C++ call, so a deep guest call chain needs a deep host stack.
+# The Windows default (1 MB) overflowed (0xC00000FD) in generated code. /STACK sets the reserved size of the
+# main thread and of every thread created with the default size (e.g. std::thread). Only address space is
+# reserved; pages are committed on demand.
+set(PS2X_STACK_RESERVE_MB 256 CACHE STRING "Reserved host stack per thread, in MB (MSVC)")
+if(MSVC)
+    math(EXPR PS2X_STACK_RESERVE_BYTES "${PS2X_STACK_RESERVE_MB} * 1024 * 1024")
+    target_link_options(ps2EntryRunner PRIVATE "/STACK:${PS2X_STACK_RESERVE_BYTES}")
+
+    # Linker map (public symbols with RVAs): lets tools/resolve_profile.py name the sampling profiler's addresses
+    # without a PDB. Costs nothing at run time.
+    option(PS2X_GENERATE_LINK_MAP "Write ps2EntryRunner.map next to the executable (MSVC)" ON)
+    if(PS2X_GENERATE_LINK_MAP)
+        target_link_options(ps2EntryRunner PRIVATE "/MAP:$<TARGET_FILE_DIR:ps2EntryRunner>/ps2EntryRunner.map")
+    endif()
+endif()
+
+# Vita: Work around for GCC 10's LTO plugin
+if(PS2X_IS_VITA)
+    target_link_options(ps2EntryRunner PRIVATE "-Wl,--allow-multiple-definition")
+    target_sources(ps2EntryRunner PRIVATE src/lib/ps2_vita_runtime.cpp)
+    set_source_files_properties(src/lib/ps2_vita_runtime.cpp PROPERTIES
+        SKIP_UNITY_BUILD_INCLUSION TRUE
+        COMPILE_OPTIONS "-fno-lto"
+    )
+endif()
+
+if(PS2X_IS_ANDROID)
+    target_sources(ps2EntryRunner PRIVATE src/lib/ps2_android_runtime.cpp)
+endif()
+
+install(TARGETS ps2_runtime ps2EntryRunner
+    RUNTIME DESTINATION bin
+    LIBRARY DESTINATION lib
+    ARCHIVE DESTINATION lib
+)
