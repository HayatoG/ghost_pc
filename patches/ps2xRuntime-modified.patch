+    const uint32_t byteIndex = watchAddr - writeAddr;
+    if (byteIndex < 8u)
+    {
+        return static_cast<uint8_t>((valueLo >> (byteIndex * 8u)) & 0xFFu);
+    }
+    return static_cast<uint8_t>((valueHi >> ((byteIndex - 8u) * 8u)) & 0xFFu);
+}
