+// Saves the visible part of the guest frame texture as <dir>/<name>.png (native resolution, no window scaling).
+static void saveGuestFrame(const Texture2D &frame, uint32_t visibleWidth, uint32_t visibleHeight,
+                           const std::string &dir, const std::string &name)
+{
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+
+    Image image = LoadImageFromTexture(frame);
+    ImageCrop(&image, Rectangle{0.0f, 0.0f, static_cast<float>(visibleWidth), static_cast<float>(visibleHeight)});
+    const std::filesystem::path path = std::filesystem::path(dir) / (name + ".png");
+    const bool ok = ExportImage(image, path.string().c_str());
+    UnloadImage(image);
+    std::cout << "[shot] " << (ok ? "saved " : "FAILED ") << path.string() << std::endl;
+}
+
+// PS2X_GUEST_CLOCK_ONLY: latches the GS frame on the calling (EE) thread and saves it, so a `shot` shows the
+// frame of the exact guest vsync instead of whatever the window thread latched last. Same pixels/crop as
+// UploadFrame + saveGuestFrame (RGBA8, at most FB_WIDTH x FB_HEIGHT).
+static void saveExactVsyncFrame(GS &gs, const std::string &dir, const std::string &name)
+{
+    gs.latchHostPresentationFrame();
+    std::vector<uint8_t> pixels;
+    uint32_t width = 0u;
+    uint32_t height = 0u;
+    bool ok = gs.copyLatchedHostPresentationFrame(pixels, width, height) && width != 0u && height != 0u;
+    const std::filesystem::path path = std::filesystem::path(dir) / (name + ".png");
+    if (ok)
+    {
+        const uint32_t cropWidth = std::min<uint32_t>(width, FB_WIDTH);
+        const uint32_t cropHeight = std::min<uint32_t>(height, FB_HEIGHT);
+        std::vector<uint8_t> cropped(static_cast<size_t>(cropWidth) * cropHeight * 4u, 0u);
+        for (uint32_t y = 0; y < cropHeight; ++y)
+        {
+            const size_t srcOffset = static_cast<size_t>(y) * width * 4u;
+            const size_t rowBytes = static_cast<size_t>(cropWidth) * 4u;
+            if (srcOffset + rowBytes > pixels.size())
+                break;
+            std::memcpy(cropped.data() + static_cast<size_t>(y) * rowBytes, pixels.data() + srcOffset, rowBytes);
+        }
+        std::error_code ec;
+        std::filesystem::create_directories(dir, ec);
+        Image image{cropped.data(), static_cast<int>(cropWidth), static_cast<int>(cropHeight), 1,
+                    PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+        ok = ExportImage(image, path.string().c_str());
+    }
+    std::cout << "[shot] " << (ok ? "saved " : "FAILED ") << path.string() << " (exact vsync)" << std::endl;
+}
