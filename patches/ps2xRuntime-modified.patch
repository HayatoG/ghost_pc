+        PS2Runtime *runtime = nullptr;
+        std::string shotDir;
+    };
+
+    // Runs on the EE thread at VBlankStart (PS2X_GUEST_CLOCK_ONLY): applies the virtual pad script by the exact
+    // guest vsync, takes its screenshots and honors `quit`.
+    void onGuestVsyncPad(void *user, uint64_t vsyncTick)
+    {
+        auto *hook = static_cast<GuestVsyncPadHook *>(user);
+        if (hook == nullptr || hook->runtime == nullptr || !ps2_virtual_pad::isLoaded())
+            return;
+        const ps2_virtual_pad::FrameActions actions = ps2_virtual_pad::onFrame(vsyncTick, true);
+        for (const std::string &shotName : actions.screenshots)
+        {
+            saveExactVsyncFrame(hook->runtime->gs(), hook->shotDir, shotName);
+            std::cout << "[pad] shot " << shotName << " at guest vsync " << vsyncTick << " (EE thread)" << std::endl;
+        }
+        if (actions.quit)
+        {
+            std::cout << "[pad] virtual pad script requested quit at guest vsync " << vsyncTick << " (EE thread)"
+                      << std::endl;
+            hook->runtime->requestStop();
+        }
+    }
+}
