+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace GSMem
+{
+    class TexturePageCache
+    {
+    public:
+        static constexpr uint32_t kPageSize = 8192u;
+
+        void Invalidate() noexcept
+        {
+            m_pageBase = UINT32_MAX;
+            m_pending = false;
+        }
+
+        // byteAddress is the wrapped, swizzled VRAM address. The returned
+        // pointer is valid only until the next miss or invalidation.
+        const uint8_t* Resolve(const uint8_t* vram, uint32_t byteAddress) noexcept
+        {
+            const uint32_t pageBase = byteAddress & ~(kPageSize - 1u);
+            if (m_pageBase != pageBase)
+            {
+                std::memcpy(m_bytes.data(), vram + pageBase, kPageSize);
+                m_pageBase = pageBase;
+                m_pending = false;
+            }
+            else if (m_pending)
+            {
+                // The deferred snapshot is still byte-identical to VRAM.
+                return vram + byteAddress;
+            }
+            return m_bytes.data() + (byteAddress & (kPageSize - 1u));
+        }
+
+        // Same observable result as Resolve, but a miss does not copy the
+        // page yet: the snapshot is "pending" and, as long as nothing writes
+        // to that page, it is identical to live VRAM. Callers must call
+        // NotifyWrite before every VRAM write (or Materialize before writes
+        // whose address is unknown) and Materialize before leaving the code
+        // region that uses ResolveDeferred.
+        const uint8_t* ResolveDeferred(const uint8_t* vram, uint32_t byteAddress) noexcept
+        {
+            const uint32_t pageBase = byteAddress & ~(kPageSize - 1u);
+            if (m_pageBase != pageBase)
+            {
+                m_pageBase = pageBase;
+                m_pending = true;
+                return vram + byteAddress;
+            }
+            if (m_pending)
+                return vram + byteAddress;
+            return m_bytes.data() + (byteAddress & (kPageSize - 1u));
+        }
+
+        void Materialize(const uint8_t* vram) noexcept
+        {
+            if (m_pending)
+            {
+                std::memcpy(m_bytes.data(), vram + m_pageBase, kPageSize);
+                m_pending = false;
+            }
+        }
+
+        // Call before writing VRAM at byteAddress.
+        void NotifyWrite(const uint8_t* vram, uint32_t byteAddress) noexcept
+        {
+            if (m_pending && (byteAddress & ~(kPageSize - 1u)) == m_pageBase)
+                Materialize(vram);
+        }
+
+    private:
+        alignas(64) std::array<uint8_t, kPageSize> m_bytes{};
+        uint32_t m_pageBase = UINT32_MAX;
+        bool m_pending = false;
+    };
+}
