@@ -223,14 +223,28 @@ namespace ps2recomp
 
     CodeGenerator::~CodeGenerator() = default;
 
+    namespace
+    {
+        // VF0 is the hardware constant (0,0,0,1) and writes to it are discarded. Games use `VSUB vf0, a, b` just to
+        // set the MAC flags, so an instruction may target it: keep the flags and restore the constant right after.
+        std::string keepVu0Constant(std::string code)
+        {
+            if (code.find("ctx->vu0_vf[0] =") != std::string::npos)
+            {
+                code += " ctx->vu0_vf[0] = _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f);";
+            }
+            return code;
+        }
+    }
+
     std::string CodeGenerator::translateInstruction(const Instruction &inst)
     {
-        return InstructionTranslator(*this).translate(inst, {});
+        return keepVu0Constant(InstructionTranslator(*this).translate(inst, {}));
     }
 
     std::string CodeGenerator::translateInstruction(const Instruction &inst, const MemoryAccessHint &memoryHint)
     {
-        return InstructionTranslator(*this).translate(inst, memoryHint);
+        return keepVu0Constant(InstructionTranslator(*this).translate(inst, memoryHint));
     }
 
