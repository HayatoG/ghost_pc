+    }
+    if (m_vu0Code)
+    {
+        delete[] m_vu0Code;
+        m_vu0Code = nullptr;
+    }
+    if (m_vu0Data)
+    {
+        delete[] m_vu0Data;
+        m_vu0Data = nullptr;
+    }
+
+    if (iop_ram)
+    {
+        delete[] iop_ram;
+        iop_ram = nullptr;
+    }
