+void VU1Interpreter::reset()
+{
+    std::memset(&m_state, 0, sizeof(m_state));
+    m_state.vf[0][3] = 1.0f;
+    m_state.q = 1.0f;
+    m_state.r = 0x3F800000u;
+    m_cycle = 0;
+    resetScheduler();
