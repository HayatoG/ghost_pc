+    constexpr uint8_t laneForComponent(uint32_t component)
+    {
+        return static_cast<uint8_t>(1u << (3u - component));
+    }
+
+    // 64-bit lane masks for a VU dest field (bit 3 = x = element 0), for the per-lane ready-cycle arrays.
+    struct LaneMaskTable
+    {
+        alignas(32) int64_t masks[16][4];
+        constexpr LaneMaskTable() : masks{}
+        {
+            for (uint32_t lanes = 0; lanes < 16u; ++lanes)
+                for (uint32_t component = 0; component < 4u; ++component)
+                    masks[lanes][component] = (lanes & (8u >> component)) != 0u ? -1 : 0;
+        }
+    };
+    constexpr LaneMaskTable kLaneMasks{};
+
+    inline __m256i laneMask(uint8_t lanes)
+    {
+        return _mm256_load_si256(reinterpret_cast<const __m256i *>(kLaneMasks.masks[lanes & 0xFu]));
+    }
+
+    // Sets the ready cycle of the lanes in `lanes` (cycles stay far below 2^63, so signed compares work).
+    inline void setReadyLanes(std::array<uint64_t, 4> &row, uint8_t lanes, uint64_t cycle)
+    {
+        __m256i *const address = reinterpret_cast<__m256i *>(row.data());
+        const __m256i current = _mm256_loadu_si256(address);
+        _mm256_storeu_si256(address, _mm256_blendv_epi8(current, _mm256_set1_epi64x(static_cast<int64_t>(cycle)),
+                                                        laneMask(lanes)));
+    }
+
+    // Lowest free slot of a pipeline array whose valid slots are the set bits of mask (the same slot the old
+    // first-invalid-entry scan picked), marking it used; -1 when the array is full.
+    inline int allocSlot(uint32_t &mask, uint32_t slots)
+    {
+        const uint32_t freeSlots = ~mask & (slots >= 32u ? ~0u : ((1u << slots) - 1u));
+        if (freeSlots == 0u)
+            return -1;
+        const int index = std::countr_zero(freeSlots);
+        mask |= 1u << index;
+        return index;
+    }
+
+#ifndef PS2X_VU1_REPLAY_HARNESS
+    // PS2X_VU1_RECORD=file [PS2X_VU1_RECORD_VSYNC=N] [PS2X_VU1_RECORD_COUNT=M]: from guest vsync N on, appends the
+    // input of up to M micro-program calls (state, VU code when it changed, VU data) for the offline replay
+    // harness in tests/vu1_replay, which checks that interpreter changes keep the output bit-identical.
+    struct VuCallRecorder
+    {
+        std::FILE *file = nullptr;
+        uint64_t startVsync = 0;
+        uint32_t remaining = 0;
+        std::vector<uint8_t> lastCode[2];
+
+        VuCallRecorder()
+        {
+            const char *const path = std::getenv("PS2X_VU1_RECORD");
+            if (path == nullptr || *path == '\0')
+                return;
+            if (const char *const text = std::getenv("PS2X_VU1_RECORD_VSYNC"))
+                startVsync = std::strtoull(text, nullptr, 10);
+            remaining = 4000u;
+            if (const char *const text = std::getenv("PS2X_VU1_RECORD_COUNT"))
+                remaining = static_cast<uint32_t>(std::strtoul(text, nullptr, 10));
+            file = std::fopen(path, "wb");
+        }
+
+        void record(uint8_t unit, uint8_t kind, const VU1State &state, const uint8_t *code, uint32_t codeSize,
+                    const uint8_t *data, uint32_t dataSize, const PS2Memory *memory,
+                    uint32_t startPC, uint32_t top, uint32_t itop, uint32_t maxCycles)
+        {
+            if (file == nullptr || remaining == 0u || memory == nullptr)
+                return;
+            const uint64_t vsync = memory->gs().vsyncTick.load(std::memory_order_relaxed);
+            if (vsync < startVsync)
+                return;
+            std::vector<uint8_t> &previous = lastCode[unit & 1u];
+            const bool codeChanged = previous.size() != codeSize || std::memcmp(previous.data(), code, codeSize) != 0;
+            if (codeChanged)
+                previous.assign(code, code + codeSize);
+            const uint32_t header[10] = {0x31525556u, unit, kind, codeChanged ? 1u : 0u, startPC, top, itop,
+                                         maxCycles, codeSize, dataSize};
+            const uint32_t stateSize = static_cast<uint32_t>(sizeof(VU1State));
+            std::fwrite(header, sizeof(header), 1, file);
+            std::fwrite(&vsync, sizeof(vsync), 1, file);
+            std::fwrite(&stateSize, sizeof(stateSize), 1, file);
+            std::fwrite(&state, sizeof(VU1State), 1, file);
+            if (codeChanged)
+                std::fwrite(code, 1, codeSize, file);
+            std::fwrite(data, 1, dataSize, file);
+            std::fflush(file);
+            if (--remaining == 0u)
+            {
+                std::fclose(file);
+                file = nullptr;
+            }
+        }
+    };
+
+    VuCallRecorder &vuCallRecorder()
+    {
+        static VuCallRecorder recorder;
+        return recorder;
+    }
+#endif
+}
+
+
+void VU1Interpreter::addVfRead(InstructionUsage &usage, uint8_t reg, uint8_t lanes)
+{
+    if (lanes == 0u)
+        return;
+    for (uint32_t index = 0; index < usage.vfReadCount; ++index)
+    {
+        if (usage.vfRead[index].reg == reg)
+        {
+            usage.vfRead[index].lanes |= lanes;
+            return;
+        }
+    }
+    if (usage.vfReadCount < usage.vfRead.size())
+        usage.vfRead[usage.vfReadCount++] = {reg, lanes};
+}
+
+void VU1Interpreter::addVfWrite(InstructionUsage &usage, uint8_t reg, uint8_t lanes)
+{
+    if (reg == 0u || lanes == 0u)
+        return;
+    if (usage.vfWrite.reg == 0u)
+        usage.vfWrite = {reg, lanes};
+    else if (usage.vfWrite.reg == reg)
+        usage.vfWrite.lanes |= lanes;
+}
+
+uint8_t VU1Interpreter::vfReadLanes(const InstructionUsage &usage, uint8_t reg)
+{
+    for (uint32_t index = 0; index < usage.vfReadCount; ++index)
+    {
+        if (usage.vfRead[index].reg == reg)
+            return usage.vfRead[index].lanes;
+    }
+    return 0u;
+}
