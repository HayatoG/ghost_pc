-uint32_t GSCpuBackend::LookupCLUT(const GSDrawState &state,
-                                  uint8_t index,
-                                  uint8_t cpsm,
-                                  uint8_t csm,
-                                  uint8_t csa,
-                                  uint8_t sourcePsm)
