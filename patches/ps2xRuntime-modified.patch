-        size_t appendGuestRingBytes(uint32_t mpegAddr,
-                                    MpegPlaybackState &playback,
-                                    const uint8_t *rdram,
-                                    uint32_t dataAddr,
-                                    uint32_t byteCount,
-                                    uint32_t ringBaseAddr,
-                                    uint32_t ringSize,
-                                    std::vector<MpegStreamCallbackEvent> &callbackEvents)
