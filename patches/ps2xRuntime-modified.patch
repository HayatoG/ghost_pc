+// PS2X_TARGET_FPS: host presentation cap. Unset -> 60, 0 -> unlimited (for benchmarking).
+static int hostTargetFps()
+{
+    const char *value = std::getenv("PS2X_TARGET_FPS");
+    if (value == nullptr || *value == '\0')
+    {
+        return DEFAULT_HOST_TARGET_FPS;
+    }
+
+    char *end = nullptr;
+    const long parsed = std::strtol(value, &end, 10);
+    if (end == value || *end != '\0' || parsed < 0 || parsed > 100000)
+    {
+        std::cerr << "[perf] ignoring invalid PS2X_TARGET_FPS='" << value << "'" << std::endl;
+        return DEFAULT_HOST_TARGET_FPS;
+    }
+    return static_cast<int>(parsed);
+}
