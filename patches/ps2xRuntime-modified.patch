+    // mask because the mask keeps far fewer than 29 bits.
+    struct SeparableSwizzle
+    {
+        uint32_t pageW = 0;
+        uint32_t pageH = 0;
+        uint32_t pixelsPerPage = 0;
+        bool valid = false;
+        std::array<uint32_t, 128> tx{};
+        std::array<uint32_t, 128> ty{};
+        std::array<uint32_t, 32> tb{};
+
+        uint32_t Base(uint32_t block) const { return (block / 32u) * pixelsPerPage + tb[block % 32u]; }
+        uint32_t Column(uint32_t x) const { return (x / pageW) * pixelsPerPage + tx[x % pageW]; }
+        uint32_t Row(uint32_t bw, uint32_t y) const { return (y / pageH) * ((bw * 64u) / pageW) * pixelsPerPage + ty[y % pageH]; }
+    };
+
+    template <GSMem::PixelStorageMode psm>
+    SeparableSwizzle buildSeparableSwizzle(const typename GSMem::PixelStorageTraits<psm>::PageLookupTableT &t)
+    {
+        using Traits = GSMem::PixelStorageTraits<psm>;
+        constexpr auto extent = Traits::PageExtent();
+        SeparableSwizzle s;
+        s.pageW = extent.x;
+        s.pageH = extent.y;
+        s.pixelsPerPage = static_cast<uint32_t>(Traits::PixelsPerPage());
+        const uint32_t t0 = t[0][0][0];
+        for (uint32_t x = 0; x < extent.x; ++x)
+            s.tx[x] = t[0][0][x] - t0;
+        for (uint32_t y = 0; y < extent.y; ++y)
+            s.ty[y] = t[0][y][0] - t0;
+        for (uint32_t b = 0; b < 32u; ++b)
+            s.tb[b] = t[b][0][0];
+        s.valid = extent.x <= 128u && extent.y <= 128u;
+        for (uint32_t b = 0; b < 32u && s.valid; ++b)
+            for (uint32_t y = 0; y < extent.y && s.valid; ++y)
+                for (uint32_t x = 0; x < extent.x; ++x)
+                    if (static_cast<uint32_t>(t[b][y][x]) != s.tb[b] + s.tx[x] + s.ty[y])
+                    {
+                        s.valid = false;
+                        break;
+                    }
+        return s;
+    }
+
+    const SeparableSwizzle &swizzleC32()
+    {
+        static const SeparableSwizzle s = buildSeparableSwizzle<GSMem::C32>(GSMem::GetPageTableC32());
+        return s;
+    }
+    const SeparableSwizzle &swizzleZ32()
+    {
+        static const SeparableSwizzle s = buildSeparableSwizzle<GSMem::Z32>(GSMem::GetPageTableZ32());
+        return s;
+    }
+    const SeparableSwizzle &swizzleZ16S()
+    {
+        static const SeparableSwizzle s = buildSeparableSwizzle<GSMem::Z16S>(GSMem::GetPageTableZ16S());
+        return s;
+    }
+
+    // Compact form of a page table: T[b][y][x] = tb[b] + T0[y][x] (the block
+    // offset only adds b * pixelsPerBlock). T0 is one page (4-32 KB) instead
+    // of 32 (128-512 KB), so it stays in L1 while texturing.
+    struct CompactSwizzle
+    {
+        bool valid = false;
+        std::array<uint32_t, 32> tb{};
+        std::vector<uint16_t> t0;
+
+        uint32_t Base(uint32_t block, uint32_t pixelsPerPage) const { return (block / 32u) * pixelsPerPage + tb[block % 32u]; }
+    };
+
+    template <GSMem::PixelStorageMode psm>
+    CompactSwizzle buildCompactSwizzle(const typename GSMem::PixelStorageTraits<psm>::PageLookupTableT &t)
+    {
+        constexpr auto extent = GSMem::PixelStorageTraits<psm>::PageExtent();
+        CompactSwizzle s;
+        s.t0.resize(static_cast<size_t>(extent.x) * extent.y);
+        for (uint32_t y = 0; y < extent.y; ++y)
+            for (uint32_t x = 0; x < extent.x; ++x)
+                s.t0[y * extent.x + x] = t[0][y][x];
+        s.valid = true;
+        for (uint32_t b = 0; b < 32u && s.valid; ++b)
+        {
+            s.tb[b] = static_cast<uint32_t>(t[b][0][0]) - static_cast<uint32_t>(t[0][0][0]);
+            for (uint32_t y = 0; y < extent.y && s.valid; ++y)
+                for (uint32_t x = 0; x < extent.x; ++x)
+                    if (static_cast<uint32_t>(t[b][y][x]) != s.tb[b] + s.t0[y * extent.x + x])
+                    {
+                        s.valid = false;
+                        break;
+                    }
+        }
+        return s;
+    }
+
+    const CompactSwizzle &compactC32()
+    {
+        static const CompactSwizzle s = buildCompactSwizzle<GSMem::C32>(GSMem::GetPageTableC32());
+        return s;
+    }
+    const CompactSwizzle &compactP8()
+    {
+        static const CompactSwizzle s = buildCompactSwizzle<GSMem::P8>(GSMem::GetPageTableP8());
+        return s;
+    }
+    const CompactSwizzle &compactP4()
+    {
+        static const CompactSwizzle s = buildCompactSwizzle<GSMem::P4>(GSMem::GetPageTableP4());
+        return s;
+    }
+
+    // readTexelInline with the compact table; base = CompactSwizzle::Base(block),
+    // rowPages = (bw * 64) / pageWidth. Same address mod 2^32.
+    template <GSMem::PixelStorageMode psm>
+    GS_FORCEINLINE uint32_t readTexelCompact(GSMem::TexturePageCache &cache, const uint8_t *vram, const uint16_t *t0,
+                                             uint32_t base, uint32_t rowPages, uint32_t x, uint32_t y)
+    {
+        using Traits = GSMem::PixelStorageTraits<psm>;
+        using PackedT = typename Traits::PackedT;
+        constexpr auto pageExtent = Traits::PageExtent();
+        constexpr uint32_t pixelsPerPage = static_cast<uint32_t>(Traits::PixelsPerPage());
+        constexpr uint32_t unpackedBits = static_cast<uint32_t>(GSMem::UnpackedBitWidth(psm));
+        constexpr uint32_t bitOffset = static_cast<uint32_t>(Traits::BitOffset());
+        constexpr uint32_t byteMask = static_cast<uint32_t>(GSMem::MEMORY_SIZE - sizeof(PackedT));
+
+        const uint32_t page = (y / pageExtent.y) * rowPages + (x / pageExtent.x);
+        const uint32_t pixelAddress = base + page * pixelsPerPage + t0[(y % pageExtent.y) * pageExtent.x + (x % pageExtent.x)];
+        const uint32_t bits = pixelAddress * unpackedBits + bitOffset;
+        const uint8_t *source = cache.ResolveDeferred(vram, (bits / 8u) & byteMask);
+        PackedT v;
+        std::memcpy(&v, source, sizeof(PackedT));
+        if constexpr (psm == GSMem::C24 || psm == GSMem::Z24)
+            return v & 0x00FFFFFFu;
+        else if constexpr (psm == GSMem::P4 || psm == GSMem::P4HL || psm == GSMem::P4HH)
+            return (v >> (bits % 8u)) & 0x0Fu;
+        else
+            return v;
+    }
+
+    constexpr uint32_t kMask32 = static_cast<uint32_t>(GSMem::MEMORY_SIZE - 4u);
+    constexpr uint32_t kMask16 = static_cast<uint32_t>(GSMem::MEMORY_SIZE - 2u);
+
+    // Explicit scalar float operations. Under /fp:fast the compiler is free to
+    // contract a*b+c into an FMA and picks *which* product to fuse per call
+    // site, so a refactor can change results by an ulp. The rasterizer pins
+    // the exact sequence the original code compiled to (verified in its
+    // disassembly) with these.
+    GS_FORCEINLINE float fmaF(float a, float b, float c)
+    {
+        return _mm_cvtss_f32(_mm_fmadd_ss(_mm_set_ss(a), _mm_set_ss(b), _mm_set_ss(c)));
+    }
+    GS_FORCEINLINE double fmaD(double a, double b, double c)
+    {
+        return _mm_cvtsd_f64(_mm_fmadd_sd(_mm_set_sd(a), _mm_set_sd(b), _mm_set_sd(c)));
+    }
+    GS_FORCEINLINE float mulF(float a, float b)
+    {
+        return _mm_cvtss_f32(_mm_mul_ss(_mm_set_ss(a), _mm_set_ss(b)));
+    }
+    GS_FORCEINLINE float subF(float a, float b)
+    {
+        return _mm_cvtss_f32(_mm_sub_ss(_mm_set_ss(a), _mm_set_ss(b)));
+    }
+    // a0*w0 + a1*w1 + a2*w2 as compiled originally: first product rounded,
+    // the other two fused left to right.
+    GS_FORCEINLINE float interp3(float a0, float a1, float a2, float w0, float w1, float w2)
+    {
+        return fmaF(w2, a2, fmaF(w1, a1, mulF(a0, w0)));
+    }
+}
