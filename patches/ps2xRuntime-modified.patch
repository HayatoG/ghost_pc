-        }
-    }
-
-    const uint32_t newAddr = allocateGuestBlockLocked(newSize, normalizedAlignment);
-    if (newAddr == 0u)
-    {
-        return 0u;
-    }
-
-    uint8_t *rdram = m_memory.getRDRAM();
-    if (rdram)
-    {
-        const uint32_t copyBytes = std::min(oldSize, newSize);
-        uint32_t dstPhys = newAddr & PS2_RAM_MASK;
