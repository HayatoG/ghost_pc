+GSCpuBackend::GSCpuBackend()
+{
+    using namespace GSMem;
+    static std::once_flag lookupTablesOnce;
+    std::call_once(lookupTablesOnce, []()
+                   { InitLookupTables(); });
+    for (size_t i = 0; i < kPsmHandlerCount; ++i)
+    {
+        switch (i)
+        {
+        case GS_PSM_CT32:
+            m_readVramFuncs[i] = ReadCT32;
+            m_writeVramFuncs[i] = WriteCT32;
+            break;
+        case GS_PSM_CT24:
+            m_readVramFuncs[i] = ReadCT24;
+            m_writeVramFuncs[i] = WriteCT24;
+            break;
+        case GS_PSM_CT16:
+            m_readVramFuncs[i] = ReadCT16;
+            m_writeVramFuncs[i] = WriteCT16;
+            break;
+        case GS_PSM_CT16S:
+            m_readVramFuncs[i] = ReadCT16S;
+            m_writeVramFuncs[i] = WriteCT16S;
+            break;
+        case GS_PSM_T8:
+            m_readVramFuncs[i] = ReadP8;
+            m_writeVramFuncs[i] = WriteP8;
+            break;
+        case GS_PSM_T8H:
+            m_readVramFuncs[i] = ReadP8H;
+            m_writeVramFuncs[i] = WriteP8H;
+            break;
+        case GS_PSM_T4:
+            m_readVramFuncs[i] = ReadP4;
+            m_writeVramFuncs[i] = WriteP4;
+            break;
+        case GS_PSM_T4HH:
+            m_readVramFuncs[i] = ReadP4HH;
+            m_writeVramFuncs[i] = WriteP4HH;
+            break;
+        case GS_PSM_T4HL:
+            m_readVramFuncs[i] = ReadP4HL;
+            m_writeVramFuncs[i] = WriteP4HL;
+            break;
+        case GS_PSM_Z32:
+            m_readVramFuncs[i] = ReadZ32;
+            m_writeVramFuncs[i] = WriteZ32;
+            break;
+        case GS_PSM_Z24:
+            m_readVramFuncs[i] = ReadZ24;
+            m_writeVramFuncs[i] = WriteZ24;
+            break;
+        case GS_PSM_Z16:
+            m_readVramFuncs[i] = ReadZ16;
+            m_writeVramFuncs[i] = WriteZ16;
+            break;
+        case GS_PSM_Z16S:
+            m_readVramFuncs[i] = ReadZ16S;
+            m_writeVramFuncs[i] = WriteZ16S;
+            break;
+        default:
+            m_readVramFuncs[i] = ReadNull;
+            m_writeVramFuncs[i] = WriteNull;
+            break;
+        }
+    }
+    if (GSFeatureStats::EnabledFromEnv())
+        m_featureStats = std::make_unique<GSFeatureStats>();
+    if (const char *recordPath = std::getenv("PS2X_GS_RECORD"); recordPath && *recordPath)
+    {
+        m_recorder = std::make_unique<Recorder>();
+        m_recorder->path = recordPath;
+        if (const char *v = std::getenv("PS2X_GS_RECORD_VSYNC"))
+            m_recorder->startVsync = std::strtoull(v, nullptr, 10);
+        if (const char *n = std::getenv("PS2X_GS_RECORD_PRESENTS"))
+            m_recorder->presentsLeft = std::max<uint32_t>(1u, static_cast<uint32_t>(std::strtoul(n, nullptr, 10)));
+    }
+    m_pixelSetup = std::make_unique<PixelSetup>();
+    m_textureSetup = std::make_unique<TextureSetup>();
+    Reset();
+}
+
+GSCpuBackend::~GSCpuBackend()
+{
+    if (m_recorder && m_recorder->file)
+        std::fclose(m_recorder->file);
+    // Present's thread-local snapshot backends never draw, so they stay silent.
+    if (m_featureStats && !m_featureStats->Total().Empty())
+        GSFeatureStats::Print(m_featureStats->Total(), "total (backend destroyed)");
+}
+
+void GSCpuBackend::ReportFeatureStatsOnPresent()
+{
+    GSFeatureStats::Counters window;
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (!m_featureStats->OnPresent())
+            return;
+        window = m_featureStats->TakeWindow();
+    }
+    GSFeatureStats::Print(window, "last 600 presents");
+}
+
+bool GSCpuBackend::RecordingActive() const
+{
+    return m_recorder && m_recorder->file;
+}
+
+void GSCpuBackend::RecordCall(uint8_t type, const void *payload, size_t size, const void *extra, size_t extraSize)
+{
+    std::FILE *f = m_recorder->file;
+    const uint32_t total = static_cast<uint32_t>(size + extraSize);
+    std::fwrite(&type, 1, 1, f);
+    std::fwrite(&total, sizeof(total), 1, f);
+    if (size)
+        std::fwrite(payload, 1, size, f);
+    if (extraSize)
+        std::fwrite(extra, 1, extraSize, f);
+}
+
+void GSCpuBackend::RecorderOnPresent(uint64_t vsyncTick)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    Recorder &rec = *m_recorder;
+    if (rec.file)
+    {
+        RecordCall(kRecPresent, &vsyncTick, sizeof(vsyncTick));
+        if (--rec.presentsLeft == 0u)
+        {
+            const uint8_t end = kRecEnd;
+            const uint32_t zero = 0u;
+            std::fwrite(&end, 1, 1, rec.file);
+            std::fwrite(&zero, sizeof(zero), 1, rec.file);
+            std::fclose(rec.file);
+            rec.file = nullptr;
+            rec.done = true;
+            std::cout << "[gs:record] done at vsync " << vsyncTick << " -> " << rec.path << std::endl;
+        }
+        return;
+    }
+    if (rec.done || vsyncTick < rec.startVsync || !m_vram)
+        return;
+
+    rec.file = std::fopen(rec.path.c_str(), "wb");
+    if (!rec.file)
+    {
+        std::cout << "[gs:record] cannot open " << rec.path << std::endl;
+        rec.done = true;
+        return;
+    }
+    std::cout << "[gs:record] start at vsync " << vsyncTick << " presents=" << rec.presentsLeft << std::endl;
+    const uint32_t header[4] = {kRecordMagic, kRecordVersion, static_cast<uint32_t>(sizeof(GSPrimitiveBatch)),
+                                static_cast<uint32_t>(GSMem::MEMORY_SIZE)};
+    std::fwrite(header, sizeof(header), 1, rec.file);
+    std::fwrite(m_vram, 1, GSMem::MEMORY_SIZE, rec.file);
+    std::fwrite(m_clut.data(), sizeof(m_clut), 1, rec.file);
+    std::fwrite(m_clutCbp.data(), sizeof(m_clutCbp), 1, rec.file);
+    auto cacheState = std::make_unique<GSMem::TexturePageCache::State>();
+    m_texturePageCache.SaveState(*cacheState);
+    std::fwrite(cacheState.get(), sizeof(*cacheState), 1, rec.file);
+    std::fwrite(&m_transfer, sizeof(m_transfer), 1, rec.file);
+    std::fwrite(&m_transferState, sizeof(m_transferState), 1, rec.file);
+    const uint64_t lthSize = m_localToHostBuffer.size();
+    const uint64_t lthPos = m_localToHostReadPos;
+    std::fwrite(&lthSize, sizeof(lthSize), 1, rec.file);
+    if (lthSize)
+        std::fwrite(m_localToHostBuffer.data(), 1, lthSize, rec.file);
+    std::fwrite(&lthPos, sizeof(lthPos), 1, rec.file);
+}
+
+bool GSCpuBackend::RestoreRecordedState(std::FILE *f)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    uint32_t header[4] = {};
+    if (!m_vram || std::fread(header, sizeof(header), 1, f) != 1 || header[0] != kRecordMagic ||
+        header[1] != kRecordVersion || header[2] != sizeof(GSPrimitiveBatch) || header[3] != GSMem::MEMORY_SIZE)
+        return false;
+    bool ok = std::fread(m_vram, 1, GSMem::MEMORY_SIZE, f) == GSMem::MEMORY_SIZE;
+    ok = ok && std::fread(m_clut.data(), sizeof(m_clut), 1, f) == 1;
+    ok = ok && std::fread(m_clutCbp.data(), sizeof(m_clutCbp), 1, f) == 1;
+    ++m_clutVersion;
+    m_setupValid = false;
+    auto cacheState = std::make_unique<GSMem::TexturePageCache::State>();
+    ok = ok && std::fread(cacheState.get(), sizeof(*cacheState), 1, f) == 1;
+    if (ok)
+        m_texturePageCache.LoadState(*cacheState);
+    ok = ok && std::fread(&m_transfer, sizeof(m_transfer), 1, f) == 1;
+    ok = ok && std::fread(&m_transferState, sizeof(m_transferState), 1, f) == 1;
+    uint64_t lthSize = 0, lthPos = 0;
+    ok = ok && std::fread(&lthSize, sizeof(lthSize), 1, f) == 1;
+    if (ok)
+    {
+        m_localToHostBuffer.resize(static_cast<size_t>(lthSize));
+        if (lthSize)
+            ok = std::fread(m_localToHostBuffer.data(), 1, lthSize, f) == lthSize;
+    }
+    ok = ok && std::fread(&lthPos, sizeof(lthPos), 1, f) == 1;
+    m_localToHostReadPos = static_cast<size_t>(lthPos);
+    return ok;
+}
+
+void GSCpuBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    if (vram && vramSize < GSMem::MEMORY_SIZE)
+        throw std::invalid_argument("GS CPU backend requires at least 4 MiB of VRAM");
+
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_vram = vram;
+    m_vramSize = vramSize;
+    ResetUnlocked();
+}
+
+void GSCpuBackend::Reset()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (RecordingActive()) [[unlikely]]
+        RecordCall(kRecReset, nullptr, 0);
+    ResetUnlocked();
+}
+
+void GSCpuBackend::ResetUnlocked()
+{
+    m_clut.fill(0u);
+    m_clutCbp.fill(0u);
+    ++m_clutVersion;
+    m_setupValid = false;
+    m_texturePageCache.Invalidate();
+    m_transfer = {};
+    m_transfer.direction = 3u;
+    m_transferState = {};
+    m_transferState.direction = 3u;
+    m_localToHostBuffer.clear();
+    m_localToHostReadPos = 0u;
+}
+
+void GSCpuBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (RecordingActive()) [[unlikely]]
+        RecordCall(kRecSubmit, &batch, sizeof(batch));
+    if (!m_vram || batch.vertexCount == 0u)
+        return;
+    if (m_featureStats) [[unlikely]]
+        m_featureStats->OnDraw(batch);
+    DrawPrimitive(batch);
+}
+
+void GSCpuBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (RecordingActive()) [[unlikely]]
+        RecordCall(kRecLoadClut, &tex0, sizeof(tex0), &texclut, sizeof(texclut));
+    if (!m_vram || (!isFourBitIndexedPsm(tex0.psm) && !isEightBitIndexedPsm(tex0.psm)))
+        return;
+
+    switch (tex0.cld)
+    {
+    case 0u:
+    case 6u:
+    case 7u:
+        return;
+    case 1u:
+        break;
+    case 2u:
+        m_clutCbp[0] = tex0.cbp;
+        break;
+    case 3u:
+        m_clutCbp[1] = tex0.cbp;
+        break;
+    case 4u:
+        if (m_clutCbp[0] == tex0.cbp)
+            return;
+        m_clutCbp[0] = tex0.cbp;
+        break;
+    case 5u:
+        if (m_clutCbp[1] == tex0.cbp)
+            return;
+        m_clutCbp[1] = tex0.cbp;
+        break;
+    default:
+        return;
+    }
+
+    if (m_featureStats) [[unlikely]]
+        m_featureStats->OnClutLoad();
+    LoadClutUnlocked(tex0, texclut);
+}
+
+void GSCpuBackend::LoadClutUnlocked(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    ++m_clutVersion; // invalidates the expanded CLUT table and cached setups
+    const bool fourBit = isFourBitIndexedPsm(tex0.psm);
+    const bool sixteenBit = tex0.cpsm == GS_PSM_CT16 || tex0.cpsm == GS_PSM_CT16S;
+    const bool thirtyTwoBit = tex0.cpsm == GS_PSM_CT32 || tex0.cpsm == GS_PSM_CT24;
+    if (!sixteenBit && !thirtyTwoBit)
+        return;
+
+    const uint32_t entryCount = fourBit ? 16u : 256u;
+    const uint32_t csaMask = sixteenBit ? 0x1Fu : 0x0Fu;
+    const uint32_t destinationBase = (static_cast<uint32_t>(tex0.csa) & csaMask) << 4u;
+
+    const bool loadCsm1Suffix = tex0.csm == 0u && thirtyTwoBit && !fourBit;
+    const uint32_t firstEntry = loadCsm1Suffix ? destinationBase : 0u;
+
+    for (uint32_t entry = firstEntry; entry < entryCount; ++entry)
+    {
+        uint32_t sourceX = 0u;
+        uint32_t sourceY = 0u;
+        uint32_t sourceWidth = 1u;
+
+        if (tex0.csm == 0u)
+        {
+            const uint32_t sourceIndex = swizzleClutIndexCSM1(entry);
+            sourceX = sourceIndex & 0x0Fu;
+            sourceY = sourceIndex >> 4u;
+        }
+        else
+        {
+            sourceWidth = texclut.cbw != 0u ? static_cast<uint32_t>(texclut.cbw) : 1u;
+            sourceX = (static_cast<uint32_t>(texclut.cou) << 4u) + entry;
+            sourceY = static_cast<uint32_t>(texclut.cov);
+        }
+
+        const uint32_t raw = ReadTextureVramUnlocked(tex0.cpsm, tex0.cbp, sourceWidth, sourceX, sourceY); 
+        const uint32_t destination = (loadCsm1Suffix ? entry : destinationBase + entry) & (sixteenBit ? 0x1FFu : 0x0FFu);
+        if (sixteenBit)
+        {
+            m_clut[destination] = static_cast<uint16_t>(raw);
+        }
+        else
+        {
+            m_clut[destination] = static_cast<uint16_t>(raw & 0xFFFFu);
+            m_clut[destination + 256u] = static_cast<uint16_t>(raw >> 16u);
+        }
+    }
+}
+
+void GSCpuBackend::Flush()
+{
+    // CPU backend is immediate. GPU backends may submit command buffers here.
+}
+
+void GSCpuBackend::TextureFlush()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (RecordingActive()) [[unlikely]]
+        RecordCall(kRecTextureFlush, nullptr, 0);
+    m_texturePageCache.Invalidate();
+}
+
+void GSCpuBackend::Sync(GSSyncReason reason)
+{
+    // CPU backend is immediate. GPU backends may wait on fences/readbacks here.
+    if (m_featureStats) [[unlikely]]
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_featureStats->OnSync(reason);
+    }
+}
+
+uint32_t GSCpuBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return ReadVramUnlocked(psm, base, bw, x, y);
+}
+
+uint32_t GSCpuBackend::ReadVramUnlocked(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    if (!m_vram)
+        return 0u;
+    return m_readVramFuncs[psm & 0x3Fu](m_vram, base, bw, x, y);
+}
+
+uint32_t GSCpuBackend::ReadTextureVramUnlocked(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y)
+{
+    if (!m_vram)
+        return 0u;
+
+    return GSMem::ReadTexture(m_texturePageCache, m_vram, psm, base, bw, x, y);
+}
+
+void GSCpuBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (RecordingActive()) [[unlikely]]
+    {
+        const uint32_t args[6] = {psm, base, bw, x, y, value};
+        RecordCall(kRecWriteVram, args, sizeof(args));
+    }
+    WriteVramUnlocked(psm, base, bw, x, y, value);
+}
+
+void GSCpuBackend::WriteVramUnlocked(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    if (!m_vram)
+        return;
+    m_writeVramFuncs[psm & 0x3Fu](m_vram, base, bw, x, y, value);
+}
+
+void GSCpuBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram || m_vramSize == 0u)
+    {
+        out.clear();
+        return;
+    }
+    out.resize(m_vramSize);
+    std::memcpy(out.data(), m_vram, m_vramSize);
+}
+
+GSTransferSnapshot GSCpuBackend::GetTransferSnapshot() const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    GSTransferSnapshot result = m_transferState;
+    result.localToHostPendingBytes = m_localToHostReadPos < m_localToHostBuffer.size()
+                                         ? m_localToHostBuffer.size() - m_localToHostReadPos
+                                         : 0u;
+    return result;
+}
+
+void GSCpuBackend::DrawPrimitive(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const auto &ctx = state.context;
+    PS2_IF_AGRESSIVE_LOGS({
+        const uint32_t primitiveIndex = s_debugPrimitiveCount.fetch_add(1u, std::memory_order_relaxed);
+        if (primitiveIndex < 64u)
+        {
+            std::cout << "[gs:prim] idx=" << primitiveIndex
+                      << " type=" << static_cast<uint32_t>(state.prim.type)
+                      << " tme=" << static_cast<uint32_t>(state.prim.tme)
+                      << " abe=" << static_cast<uint32_t>(state.prim.abe)
+                      << " fst=" << static_cast<uint32_t>(state.prim.fst)
+                      << " ctxt=" << static_cast<uint32_t>(state.prim.ctxt)
+                      << " fbp=" << ctx.frame.fbp
+                      << " fbw=" << ctx.frame.fbw
+                      << " psm=0x" << std::hex << static_cast<uint32_t>(ctx.frame.psm) << std::dec
+                      << " tex0=("
+                      << "tbp0=" << ctx.tex0.tbp0
+                      << " tbw=" << static_cast<uint32_t>(ctx.tex0.tbw)
+                      << " psm=0x" << std::hex << static_cast<uint32_t>(ctx.tex0.psm) << std::dec
+                      << " tw=" << static_cast<uint32_t>(ctx.tex0.tw)
+                      << " th=" << static_cast<uint32_t>(ctx.tex0.th)
+                      << " tcc=" << static_cast<uint32_t>(ctx.tex0.tcc)
+                      << " tfx=" << static_cast<uint32_t>(ctx.tex0.tfx)
+                      << " cbp=" << ctx.tex0.cbp
+                      << " cpsm=0x" << std::hex << static_cast<uint32_t>(ctx.tex0.cpsm) << std::dec
+                      << " csm=" << static_cast<uint32_t>(ctx.tex0.csm)
+                      << " csa=" << static_cast<uint32_t>(ctx.tex0.csa)
+                      << ")"
+                      << " texclut=("
+                      << "cbw=" << static_cast<uint32_t>(state.texclut.cbw)
+                      << " cou=" << static_cast<uint32_t>(state.texclut.cou)
+                      << " cov=" << state.texclut.cov
+                      << ")"
+                      << " ofx=" << (ctx.xyoffset.ofx >> 4)
+                      << " ofy=" << (ctx.xyoffset.ofy >> 4)
+                      << " scissor=(" << ctx.scissor.x0
+                      << "," << ctx.scissor.y0
+                      << ")-(" << ctx.scissor.x1
+                      << "," << ctx.scissor.y1 << ")"
+                      << " test=0x" << std::hex << ctx.test
+                      << " alpha=0x" << ctx.alpha
+                      << std::dec
+                      << " v0=(" << batch.vertices[0].x << "," << batch.vertices[0].y << ")"
+                      << " uv0=(" << (batch.vertices[0].u >> 4) << "," << (batch.vertices[0].v >> 4) << ")"
+                      << " stq0=(" << batch.vertices[0].s << "," << batch.vertices[0].t << "," << batch.vertices[0].q << ")"
+                      << " v1=(" << batch.vertices[1].x << "," << batch.vertices[1].y << ")"
+                      << " uv1=(" << (batch.vertices[1].u >> 4) << "," << (batch.vertices[1].v >> 4) << ")"
+                      << " stq1=(" << batch.vertices[1].s << "," << batch.vertices[1].t << "," << batch.vertices[1].q << ")"
+                      << " v2=(" << batch.vertices[2].x << "," << batch.vertices[2].y << ")"
+                      << " uv2=(" << (batch.vertices[2].u >> 4) << "," << (batch.vertices[2].v >> 4) << ")"
+                      << " stq2=(" << batch.vertices[2].s << "," << batch.vertices[2].t << "," << batch.vertices[2].q << ")"
+                      << " rgba0=(" << static_cast<uint32_t>(batch.vertices[0].r) << ","
+                      << static_cast<uint32_t>(batch.vertices[0].g) << ","
+                      << static_cast<uint32_t>(batch.vertices[0].b) << ","
+                      << static_cast<uint32_t>(batch.vertices[0].a) << ")"
+                      << " rgba1=(" << static_cast<uint32_t>(batch.vertices[1].r) << ","
+                      << static_cast<uint32_t>(batch.vertices[1].g) << ","
+                      << static_cast<uint32_t>(batch.vertices[1].b) << ","
+                      << static_cast<uint32_t>(batch.vertices[1].a) << ")"
+                      << " rgba2=(" << static_cast<uint32_t>(batch.vertices[2].r) << ","
+                      << static_cast<uint32_t>(batch.vertices[2].g) << ","
+                      << static_cast<uint32_t>(batch.vertices[2].b) << ","
+                      << static_cast<uint32_t>(batch.vertices[2].a) << ")"
+                      << std::endl;
+        }
+    });
+
+    PS2_IF_AGRESSIVE_LOGS({
+        if ((state.prim.ctxt != 0u || ctx.frame.fbp == 150u) &&
+            s_debugContext1PrimitiveCount.fetch_add(1u, std::memory_order_relaxed) < 32u)
+        {
+            std::cout << "[gs:copy-prim]"
+                      << " type=" << static_cast<uint32_t>(state.prim.type)
+                      << " tme=" << static_cast<uint32_t>(state.prim.tme)
+                      << " abe=" << static_cast<uint32_t>(state.prim.abe)
+                      << " fst=" << static_cast<uint32_t>(state.prim.fst)
+                      << " ctxt=" << static_cast<uint32_t>(state.prim.ctxt)
+                      << " fbp=" << ctx.frame.fbp
+                      << " fbw=" << ctx.frame.fbw
+                      << " psm=0x" << std::hex << static_cast<uint32_t>(ctx.frame.psm) << std::dec
+                      << " tex0=("
+                      << "tbp0=" << ctx.tex0.tbp0
+                      << " tbw=" << static_cast<uint32_t>(ctx.tex0.tbw)
+                      << " psm=0x" << std::hex << static_cast<uint32_t>(ctx.tex0.psm) << std::dec
+                      << " tcc=" << static_cast<uint32_t>(ctx.tex0.tcc)
+                      << " tfx=" << static_cast<uint32_t>(ctx.tex0.tfx)
+                      << " cbp=" << ctx.tex0.cbp
+                      << " cpsm=0x" << std::hex << static_cast<uint32_t>(ctx.tex0.cpsm) << std::dec
+                      << " csm=" << static_cast<uint32_t>(ctx.tex0.csm)
+                      << " csa=" << static_cast<uint32_t>(ctx.tex0.csa)
+                      << ")"
+                      << " texclut=("
+                      << "cbw=" << static_cast<uint32_t>(state.texclut.cbw)
+                      << " cou=" << static_cast<uint32_t>(state.texclut.cou)
+                      << " cov=" << state.texclut.cov
+                      << ")"
+                      << " ofx=" << (ctx.xyoffset.ofx >> 4)
+                      << " ofy=" << (ctx.xyoffset.ofy >> 4)
+                      << " scissor=(" << ctx.scissor.x0
+                      << "," << ctx.scissor.y0
+                      << ")-(" << ctx.scissor.x1
+                      << "," << ctx.scissor.y1 << ")"
+                      << " test=0x" << std::hex << ctx.test
+                      << " alpha=0x" << ctx.alpha
+                      << std::dec << std::endl;
+        }
+    });
+
+    switch (state.prim.type)
+    {
+    case GS_PRIM_SPRITE:
+        DrawSprite(batch);
+        break;
+    case GS_PRIM_TRIANGLE:
+    case GS_PRIM_TRISTRIP:
+    case GS_PRIM_TRIFAN:
+        DrawTriangle(batch);
+        break;
+    case GS_PRIM_LINE:
+    case GS_PRIM_LINESTRIP:
+        DrawLine(batch);
+        break;
+    case GS_PRIM_POINT:
+    {
+        const GSVertex &v = batch.vertices[0];
+        const auto &ctx = state.context;
+        int px = static_cast<int>(v.x) - (ctx.xyoffset.ofx >> 4);
+        int py = static_cast<int>(v.y) - (ctx.xyoffset.ofy >> 4);
+        WritePixel(state, px, py, static_cast<u32>(v.z), v.r, v.g, v.b, v.a, v.fog);
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+void GSCpuBackend::WritePixel(const GSDrawState &state, int x, int y, int z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog)
+{
+    const auto &ctx = state.context;
+    if (x < ctx.scissor.x0 || x > ctx.scissor.x1 || y < ctx.scissor.y0 || y > ctx.scissor.y1)
+        return;
+
+    if (state.prim.fge)
+    {
+        const uint32_t inverseFog = 255u - fog;
+        auto applyFog = [&](uint8_t input, uint8_t fogColor) -> uint8_t
+        {
+            return static_cast<uint8_t>(((static_cast<uint32_t>(fog) * input) >> 8) + ((inverseFog * fogColor) >> 8));
+        };
+
+        r = applyFog(r, state.fogR);
+        g = applyFog(g, state.fogG);
+        b = applyFog(b, state.fogB);
+    }
+
+    const u32 fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    const u32 fbw = std::max<u32>(ctx.frame.fbw, 1u);
+    const u32 fpsm = ctx.frame.psm;
+    const u32 zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    const u32 zpsm = ctx.zbuf.psm;
+
+    const PixelWriteMask writeMask = classifyAlphaTest(ctx.test, a, static_cast<uint8_t>(fpsm));
+    if (!writeMask.writesAnything())
+    {
+        return;
+    }
+
+    const uint32_t ztestMethod = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+    const bool alphaBlendEnabled = state.prim.abe;
+    const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha && fpsm == GS_PSM_CT32;
+    const bool destinationAlphaTestNeedsRead = ((ctx.test >> 14) & 0x1u) != 0u && (fpsm == GS_PSM_CT32 || fpsm == GS_PSM_CT16 || fpsm == GS_PSM_CT16S);
+
+    // small optimization, avoid reading the framebuffer for simple draws
+    // TODO: only one address lookup for rmw
+    const bool frmw = destinationAlphaTestNeedsRead || (writeMask.writesFramebuffer() && ((ctx.frame.fbmsk != 0) || alphaBlendEnabled || preserveDestinationAlpha));
+
+    u32 rawFramebufferPixel = 0;
+    u32 fbrgba = 0;
+    if (frmw)
+    {
+        rawFramebufferPixel = ReadVramUnlocked(fpsm, fbp, fbw, x, y);
+        fbrgba = rawFramebufferPixel;
+
+        if (bitsPerPixel(fpsm) == 16)
+        {
+            fbrgba = Rgba5551ToRgba8888(fbrgba);
+        }
+        else if (fpsm == GS_PSM_CT24)
+        {
+            // The GS supplies 0x80 as destination alpha for RGB24 blending.
+            fbrgba |= 0x80000000u;
+        }
+    }
+
+    if (!passesDestinationAlphaTest(ctx.test, static_cast<uint8_t>(fpsm), rawFramebufferPixel))
+    {
+        return;
+    }
+
+    bool zpass = false;
+    uint32_t storedZ = 0u;
+    switch (ztestMethod)
+    {
+    case 0:
+        zpass = false;
+        break;
+    case 1:
+        zpass = true;
+        break;
+    case 2:
+        storedZ = ReadVramUnlocked(zpsm, zbp, fbw, x, y);
+        zpass = static_cast<uint32_t>(z) >= storedZ;
+        break;
+    case 3:
+        storedZ = ReadVramUnlocked(zpsm, zbp, fbw, x, y);
+        zpass = static_cast<uint32_t>(z) > storedZ;
+        break;
+    }
+
+    if (!zpass)
+    {
+        return;
+    }
+
+    if (writeMask.writesFramebuffer())
+    {
+        const u8 srcR = r;
+        const u8 srcG = g;
+        const u8 srcB = b;
+
+        if (state.prim.abe)
+        {
+            uint8_t dr = fbrgba & 0xFF;
+            uint8_t dg = (fbrgba >> 8) & 0xFF;
+            uint8_t db = (fbrgba >> 16) & 0xFF;
+            uint8_t da = (fbrgba >> 24) & 0xFF;
+
+            // PABE disables alpha blending when the source alpha MSB is clear.
+            if (!(state.pabe && (a & 0x80u) == 0u))
+            {
+                uint64_t alphaReg = ctx.alpha;
+                uint8_t asel = alphaReg & 3;
+                uint8_t bsel = (alphaReg >> 2) & 3;
+                uint8_t csel = (alphaReg >> 4) & 3;
+                uint8_t dsel = (alphaReg >> 6) & 3;
+                uint8_t fix = static_cast<uint8_t>((alphaReg >> 32) & 0xFF);
+
+                auto pickRGB = [&](uint8_t sel, int cs, int cd) -> int
+                {
+                    if (sel == 0)
+                        return cs;
+                    if (sel == 1)
+                        return cd;
+                    return 0;
+                };
+                int cAlpha = (csel == 0) ? a : (csel == 1) ? da
+                                                           : fix;
+
+                r = clampU8(((pickRGB(asel, r, dr) - pickRGB(bsel, r, dr)) * cAlpha >> 7) + pickRGB(dsel, r, dr));
+                g = clampU8(((pickRGB(asel, g, dg) - pickRGB(bsel, g, dg)) * cAlpha >> 7) + pickRGB(dsel, g, dg));
+                b = clampU8(((pickRGB(asel, b, db) - pickRGB(bsel, b, db)) * cAlpha >> 7) + pickRGB(dsel, b, db));
+            }
+            else
+            {
+                r = srcR;
+                g = srcG;
+                b = srcB;
+            }
+        }
+
+        if (writeMask.writeAlpha && (ctx.fba & 0x1ull) != 0ull && ctx.frame.psm != GS_PSM_CT24)
+        {
+            a = static_cast<uint8_t>(a | 0x80u);
+        }
+
+        u32 pixel = pack32(r, g, b, a);
+
+        if (ctx.frame.fbmsk != 0)
+        {
+            pixel = (pixel & ~ctx.frame.fbmsk) | (fbrgba & ctx.frame.fbmsk);
+        }
+
+        if (preserveDestinationAlpha)
+        {
+            pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+        }
+
+        // format conversion
+        if (bitsPerPixel(fpsm) == 16)
+        {
+            pixel = Rgba8888ToRgba5551(pixel);
+        }
+
+        WriteVramUnlocked(fpsm, fbp, fbw, x, y, pixel);
+    }
+
+    if (writeMask.writeDepth && !ctx.zbuf.zmask)
+    {
+        WriteVramUnlocked(zpsm, zbp, fbw, x, y, z);
+    }
+}
+
+uint32_t GSCpuBackend::LookupCLUT(const GSDrawState &state,
+                                  uint8_t index,
+                                  uint8_t cpsm,
+                                  uint8_t csm,
+                                  uint8_t csa,
+                                  uint8_t sourcePsm)
+{
+    const bool sixteenBit = cpsm == GS_PSM_CT16 || cpsm == GS_PSM_CT16S;
+    const uint32_t csaMask = sixteenBit ? 0x1Fu : 0x0Fu;
+    const uint32_t clutBase = (static_cast<uint32_t>(csa) & csaMask) << 4u;
+    const uint32_t sourceIndex = isFourBitIndexedPsm(sourcePsm)
+                                     ? (static_cast<uint32_t>(index) & 0x0Fu)
+                                     : static_cast<uint32_t>(index);
+
+    uint32_t clutIndex = (clutBase + sourceIndex) & (sixteenBit ? 0x1FFu : 0x0FFu);
+    if (!sixteenBit && csm == 0u && isEightBitIndexedPsm(sourcePsm))
+    {
+        const uint32_t block = std::min((sourceIndex & 0xF0u) + clutBase, 240u);
+        clutIndex = block + (sourceIndex & 0x0Fu);
+    }
+
+    switch (cpsm)
+    {
+    case GS_PSM_CT32:
+    {
+        const uint32_t raw = static_cast<uint32_t>(m_clut[clutIndex]) | (static_cast<uint32_t>(m_clut[clutIndex + 256u]) << 16u);
+        return applyTexa(state.texa, cpsm, raw);
+    }
+    case GS_PSM_CT24:
+    {
+        const uint32_t raw = static_cast<uint32_t>(m_clut[clutIndex]) | (static_cast<uint32_t>(m_clut[clutIndex + 256u]) << 16u);
+        return applyTexa(state.texa, cpsm, raw & 0x00FFFFFFu);
+    }
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+        return applyTexa(state.texa, cpsm, Rgba5551ToRgba8888(m_clut[clutIndex]));
+    default:
+        break;
+    }
+
+    return 0xFFFF00FFu;
+}
+
+uint32_t GSCpuBackend::SampleTexture(const GSDrawState &state, float s, float t, float q, uint16_t u, uint16_t v)
+{
+    const auto &ctx = state.context;
+    const auto &tex = ctx.tex0;
+
+    const int texW = state.textureWidth;
+    const int texH = state.textureHeight;
+    const uint64_t clamp = ctx.clamp;
+    const uint8_t wrapU = static_cast<uint8_t>(clamp & 0x3u);
+    const uint8_t wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+    const uint16_t minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+    const uint16_t maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+    const uint16_t minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+    const uint16_t maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+
+    float texUf, texVf;
+    if (state.prim.fst)
+    {
+        texUf = static_cast<float>(u) / 16.0f;
+        texVf = static_cast<float>(v) / 16.0f;
+    }
+    else
+    {
+        const float invQ = 1.0f / fabsQ(q);
+        texUf = s * invQ * static_cast<float>(texW);
+        texVf = t * invQ * static_cast<float>(texH);
+    }
+
+    auto samplePoint = [&](int sampleU, int sampleV) -> uint32_t
+    {
+        sampleU = wrapTextureCoordinate(sampleU, texW, wrapU, minU, maxU);
+        sampleV = wrapTextureCoordinate(sampleV, texH, wrapV, minV, maxV);
+
+        u32 out = ReadTextureVramUnlocked(tex.psm, tex.tbp0, tex.tbw, sampleU, sampleV);
+
+        switch (tex.psm)
+        {
+        case GS_PSM_CT32:
+        case GS_PSM_Z32:
+        case GS_PSM_CT24:
+        case GS_PSM_Z24:
+            return applyTexa(state.texa, tex.psm, out);
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            return applyTexa(state.texa, tex.psm, Rgba5551ToRgba8888(out));
+        case GS_PSM_T8:
+        case GS_PSM_T8H:
+        case GS_PSM_T4:
+        case GS_PSM_T4HL:
+        case GS_PSM_T4HH:
+            return LookupCLUT(state, static_cast<u8>(out), tex.cpsm, tex.csm, tex.csa, tex.psm);
+        }
+
+        return 0xFFFF00FFu;
+    };
+
+    if (!state.linearFilter)
+    {
+        return samplePoint(static_cast<int>(texUf), static_cast<int>(texVf));
+    }
+
+    const float sampleU = texUf - 0.5f;
+    const float sampleV = texVf - 0.5f;
+    const int u0 = static_cast<int>(std::floor(sampleU));
+    const int v0 = static_cast<int>(std::floor(sampleV));
+    const int u1 = u0 + 1;
+    const int v1 = v0 + 1;
+    const float fx = sampleU - static_cast<float>(u0);
+    const float fy = sampleV - static_cast<float>(v0);
+
+    const uint32_t c00 = samplePoint(u0, v0);
+    const uint32_t c10 = samplePoint(u1, v0);
+    const uint32_t c01 = samplePoint(u0, v1);
+    const uint32_t c11 = samplePoint(u1, v1);
+
+    const uint8_t r = lerpChannel(static_cast<uint8_t>(c00 & 0xFFu),
+                                  static_cast<uint8_t>(c10 & 0xFFu),
+                                  static_cast<uint8_t>(c01 & 0xFFu),
+                                  static_cast<uint8_t>(c11 & 0xFFu),
+                                  fx, fy);
+    const uint8_t g = lerpChannel(static_cast<uint8_t>((c00 >> 8) & 0xFFu),
+                                  static_cast<uint8_t>((c10 >> 8) & 0xFFu),
+                                  static_cast<uint8_t>((c01 >> 8) & 0xFFu),
+                                  static_cast<uint8_t>((c11 >> 8) & 0xFFu),
+                                  fx, fy);
+    const uint8_t b = lerpChannel(static_cast<uint8_t>((c00 >> 16) & 0xFFu),
+                                  static_cast<uint8_t>((c10 >> 16) & 0xFFu),
+                                  static_cast<uint8_t>((c01 >> 16) & 0xFFu),
+                                  static_cast<uint8_t>((c11 >> 16) & 0xFFu),
+                                  fx, fy);
+    const uint8_t a = lerpChannel(static_cast<uint8_t>((c00 >> 24) & 0xFFu),
+                                  static_cast<uint8_t>((c10 >> 24) & 0xFFu),
+                                  static_cast<uint8_t>((c01 >> 24) & 0xFFu),
+                                  static_cast<uint8_t>((c11 >> 24) & 0xFFu),
+                                  fx, fy);
+
+    return static_cast<uint32_t>(r) |
+           (static_cast<uint32_t>(g) << 8) |
+           (static_cast<uint32_t>(b) << 16) |
+           (static_cast<uint32_t>(a) << 24);
+}
+
+void GSCpuBackend::PreparePixelSetup(const GSDrawState &state, PixelSetup &ps) const
+{
+    const auto &ctx = state.context;
+    ps.scissorX0 = ctx.scissor.x0;
+    ps.scissorX1 = ctx.scissor.x1;
+    ps.scissorY0 = ctx.scissor.y0;
+    ps.scissorY1 = ctx.scissor.y1;
+
+    ps.fge = state.prim.fge != 0;
+    ps.fogR = state.fogR;
+    ps.fogG = state.fogG;
+    ps.fogB = state.fogB;
+
+    ps.fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    ps.fbw = std::max<u32>(ctx.frame.fbw, 1u);
+    ps.fpsm = ctx.frame.psm;
+    ps.zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    ps.zpsm = ctx.zbuf.psm;
+    ps.readFrame = m_readVramFuncs[ps.fpsm & 0x3Fu];
+    ps.readDepth = m_readVramFuncs[ps.zpsm & 0x3Fu];
+    ps.writeFrame = m_writeVramFuncs[ps.fpsm & 0x3Fu];
+    ps.writeDepth = m_writeVramFuncs[ps.zpsm & 0x3Fu];
+    ps.pageTableC32 = &GSMem::GetPageTableC32();
+
+    const uint64_t test = ctx.test;
+    ps.alphaTestEnabled = (test & 0x1u) != 0u;
+    ps.alphaTestMethod = static_cast<uint8_t>((test >> 1) & 0x7u);
+    ps.alphaRef = static_cast<uint8_t>((test >> 4) & 0xFFu);
+    switch (static_cast<uint8_t>((test >> 12) & 0x3u))
+    {
+    case 1:
+        ps.alphaFailMask = {true, true, false};
+        break;
+    case 2:
+        ps.alphaFailMask = {false, false, true};
+        break;
+    case 3:
+        if (ps.fpsm == GS_PSM_CT32)
+            ps.alphaFailMask = {true, false, false};
+        else
+            ps.alphaFailMask = {true, true, false};
+        break;
+    case 0:
+    default:
+        ps.alphaFailMask = {false, false, false};
+        break;
+    }
+    ps.ztestMethod = static_cast<uint32_t>((test >> 17) & 3u);
+    ps.destinationAlphaTest = ((test >> 14) & 0x1u) != 0u;
+    ps.destinationAlphaMode = ((test >> 15) & 0x1u) != 0u;
+    switch (ps.fpsm)
+    {
+    case GS_PSM_CT32:
+        ps.destinationAlphaBit = 31u;
+        break;
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+        ps.destinationAlphaBit = 15u;
+        break;
+    default:
+        ps.destinationAlphaBit = 0u;
+        break;
+    }
+    ps.destinationAlphaTestNeedsRead = ps.destinationAlphaTest &&
+                                       (ps.fpsm == GS_PSM_CT32 || ps.fpsm == GS_PSM_CT16 || ps.fpsm == GS_PSM_CT16S);
+
+    ps.alphaBlendEnabled = state.prim.abe != 0;
+    ps.pabe = state.pabe;
+    const uint64_t alphaReg = ctx.alpha;
+    ps.asel = alphaReg & 3;
+    ps.bsel = (alphaReg >> 2) & 3;
+    ps.csel = (alphaReg >> 4) & 3;
+    ps.dsel = (alphaReg >> 6) & 3;
+    ps.fix = static_cast<uint8_t>((alphaReg >> 32) & 0xFF);
+
+    ps.fbmsk = ctx.frame.fbmsk;
+    ps.frame16 = bitsPerPixel(static_cast<uint8_t>(ps.fpsm)) == 16;
+    ps.frameCT24 = ps.fpsm == GS_PSM_CT24;
+    ps.frameCT32 = ps.fpsm == GS_PSM_CT32;
+    ps.depthZ16S = ps.zpsm == GS_PSM_Z16S;
+    ps.pageTableZ16S = &GSMem::GetPageTableZ16S();
+    ps.depthZ32 = ps.zpsm == GS_PSM_Z32 || ps.zpsm == GS_PSM_Z24;
+    ps.depthZ24 = ps.zpsm == GS_PSM_Z24;
+    ps.pageTableZ32 = &GSMem::GetPageTableZ32();
+
+    // The inlined paths need the separable swizzle; without it fall back to
+    // the generic read/write functions (same results).
+    ps.fbSwz = nullptr;
+    if (ps.frameCT32 || ps.frameCT24)
+    {
+        if (swizzleC32().valid)
+        {
+            ps.fbSwz = &swizzleC32();
+            ps.fbBase = ps.fbSwz->Base(ps.fbp);
+        }
+        else
+        {
+            // The PSMCT32 tables are constants and separable by construction;
+            // frameCT32 also selects RGB_ONLY/preserve-alpha semantics, so it
+            // cannot simply be cleared here.
+            std::abort();
+        }
+    }
+    ps.zSwz = nullptr;
+    if (ps.depthZ16S || ps.depthZ32)
+    {
+        const SeparableSwizzle &zs = ps.depthZ16S ? swizzleZ16S() : swizzleZ32();
+        if (zs.valid)
+        {
+            ps.zSwz = &zs;
+            ps.zBase = zs.Base(ps.zbp);
+            ps.zBytes = ps.depthZ16S ? 2u : 4u;
+            ps.zMask = ps.depthZ16S ? kMask16 : kMask32;
+        }
+        else
+        {
+            ps.depthZ16S = ps.depthZ32 = false;
+        }
+    }
+    ps.forceAlphaMsb = (ctx.fba & 0x1ull) != 0ull && ctx.frame.psm != GS_PSM_CT24;
+    ps.zmask = ctx.zbuf.zmask != 0;
+
+    ps.simpleWrite = !ps.fge && (!ps.alphaTestEnabled || ps.alphaTestMethod == 1u) && !ps.alphaBlendEnabled &&
+                     !ps.destinationAlphaTest && ps.ztestMethod == 1u && ps.frameCT32 && ps.fbSwz != nullptr &&
+                     (ps.zmask || ps.zSwz != nullptr);
+    ps.alphaOr = ps.forceAlphaMsb ? 0x80000000u : 0u;
+    ps.simpleBlend = !ps.fge && (!ps.alphaTestEnabled || ps.alphaTestMethod == 1u) && ps.alphaBlendEnabled &&
+                     !ps.destinationAlphaTest && ps.ztestMethod == 1u && ps.frameCT32 && ps.fbSwz != nullptr &&
+                     (ps.zmask || ps.zSwz != nullptr);
+    auto laneMask = [](bool on) { return on ? _mm_set1_epi32(-1) : _mm_setzero_si128(); };
+    ps.blendAs = laneMask(ps.asel == 0);
+    ps.blendAd = laneMask(ps.asel == 1);
+    ps.blendBs = laneMask(ps.bsel == 0);
+    ps.blendBd = laneMask(ps.bsel == 1);
+    ps.blendDs = laneMask(ps.dsel == 0);
+    ps.blendDd = laneMask(ps.dsel == 1);
+}
+
+namespace
+{
+    // GS alpha blend of the RGB channels: ((A - B) * C >> 7) + D, clamped to
+    // 0..255, with A/B/D picked from Cs/Cd/0 and C from As/Ad/FIX. Same
+    // integer arithmetic as the scalar version (arithmetic shift), 3 lanes at
+    // once. Alpha is returned unchanged.
+    template <typename PS>
+    GS_FORCEINLINE uint32_t blendColor(const PS &ps, uint32_t src, uint32_t dst)
+    {
+        const __m128i cs = _mm_cvtepu8_epi32(_mm_cvtsi32_si128(static_cast<int>(src)));
+        const __m128i cd = _mm_cvtepu8_epi32(_mm_cvtsi32_si128(static_cast<int>(dst)));
+        const __m128i va = _mm_or_si128(_mm_and_si128(cs, ps.blendAs), _mm_and_si128(cd, ps.blendAd));
+        const __m128i vb = _mm_or_si128(_mm_and_si128(cs, ps.blendBs), _mm_and_si128(cd, ps.blendBd));
+        const __m128i vd = _mm_or_si128(_mm_and_si128(cs, ps.blendDs), _mm_and_si128(cd, ps.blendDd));
+        const int cAlpha = (ps.csel == 0) ? static_cast<int>(src >> 24) : (ps.csel == 1) ? static_cast<int>(dst >> 24) : ps.fix;
+        const __m128i blended = _mm_add_epi32(_mm_srai_epi32(_mm_mullo_epi32(_mm_sub_epi32(va, vb), _mm_set1_epi32(cAlpha)), 7), vd);
+        const __m128i packed16 = _mm_packs_epi32(blended, blended);
+        const uint32_t rgb = static_cast<uint32_t>(_mm_cvtsi128_si32(_mm_packus_epi16(packed16, packed16))) & 0x00FFFFFFu;
+        return rgb | (src & 0xFF000000u);
+    }
+}
+
+void GSCpuBackend::PrepareTextureSetup(const GSDrawState &state, TextureSetup &ts)
+{
+    const auto &ctx = state.context;
+    const auto &tex = ctx.tex0;
+    ts.texa = state.texa;
+    ts.texW = state.textureWidth;
+    ts.texH = state.textureHeight;
+    const uint64_t clamp = ctx.clamp;
+    ts.wrapU = static_cast<uint8_t>(clamp & 0x3u);
+    ts.wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+    ts.minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+    ts.maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+    ts.minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+    ts.maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+    ts.fst = state.prim.fst != 0;
+    ts.linearFilter = state.linearFilter;
+
+    ts.psm = tex.psm;
+    ts.tbp0 = tex.tbp0;
+    ts.tbw = tex.tbw;
+
+    // Same typed reader selection as GSMem::ReadTexture / GetReadTextureFunc.
+    using R = TextureSetup::Read;
+    switch (static_cast<GSMem::PixelStorageMode>(tex.psm & 0x3Fu))
+    {
+    case GSMem::C32: ts.read = R::C32; ts.table = &GSMem::GetPageTableC32(); break;
+    case GSMem::C24: ts.read = R::C24; ts.table = &GSMem::GetPageTableC32(); break;
+    case GSMem::C16: ts.read = R::C16; ts.table = &GSMem::GetPageTableC16(); break;
+    case GSMem::C16S: ts.read = R::C16S; ts.table = &GSMem::GetPageTableC16S(); break;
+    case GSMem::P8: ts.read = R::P8; ts.table = &GSMem::GetPageTableP8(); break;
+    case GSMem::P4: ts.read = R::P4; ts.table = &GSMem::GetPageTableP4(); break;
+    case GSMem::P8H: ts.read = R::P8H; ts.table = &GSMem::GetPageTableC32(); break;
+    case GSMem::P4HL: ts.read = R::P4HL; ts.table = &GSMem::GetPageTableC32(); break;
+    case GSMem::P4HH: ts.read = R::P4HH; ts.table = &GSMem::GetPageTableC32(); break;
+    case GSMem::Z32: ts.read = R::Z32; ts.table = &GSMem::GetPageTableZ32(); break;
+    case GSMem::Z24: ts.read = R::Z24; ts.table = &GSMem::GetPageTableZ32(); break;
+    case GSMem::Z16: ts.read = R::Z16; ts.table = &GSMem::GetPageTableZ16(); break;
+    case GSMem::Z16S: ts.read = R::Z16S; ts.table = &GSMem::GetPageTableZ16S(); break;
+    default: ts.read = R::Null; ts.table = nullptr; break;
+    }
+
+    switch (tex.psm)
+    {
+    case GS_PSM_CT32:
+    case GS_PSM_Z32:
+    case GS_PSM_CT24:
+    case GS_PSM_Z24:
+        ts.kind = TextureSetup::Kind::Direct;
+        break;
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+    case GS_PSM_Z16:
+    case GS_PSM_Z16S:
+        ts.kind = TextureSetup::Kind::Direct16;
+        break;
+    case GS_PSM_T8:
+    case GS_PSM_T8H:
+    case GS_PSM_T4:
+    case GS_PSM_T4HL:
+    case GS_PSM_T4HH:
+        ts.kind = TextureSetup::Kind::Clut;
+        break;
+    default:
+        ts.kind = TextureSetup::Kind::Invalid;
+        break;
+    }
+
+    ts.cpsm = tex.cpsm;
+    ts.clutSixteenBit = tex.cpsm == GS_PSM_CT16 || tex.cpsm == GS_PSM_CT16S;
+    const uint32_t csaMask = ts.clutSixteenBit ? 0x1Fu : 0x0Fu;
+    ts.clutBase = (static_cast<uint32_t>(tex.csa) & csaMask) << 4u;
+    ts.clutFourBitSource = isFourBitIndexedPsm(tex.psm);
+    ts.clutCsm1EightBit = !ts.clutSixteenBit && tex.csm == 0u && isEightBitIndexedPsm(tex.psm);
+
+    ts.clutTable = nullptr;
+    if (ts.kind == TextureSetup::Kind::Clut)
+        PrepareClutTable(ts);
+
+    const CompactSwizzle *compact = nullptr;
+    uint32_t pageW = 64u, pixelsPerPage = 2048u;
+    switch (tex.psm)
+    {
+    case GS_PSM_CT32: ts.fastKind = kTexC32; compact = &compactC32(); break;
+    case GS_PSM_CT24: ts.fastKind = kTexC24; compact = &compactC32(); break;
+    case GS_PSM_T8: ts.fastKind = kTexP8; compact = &compactP8(); pageW = 128u; pixelsPerPage = 128u * 64u; break;
+    case GS_PSM_T4: ts.fastKind = kTexP4; compact = &compactP4(); pageW = 128u; pixelsPerPage = 128u * 128u; break;
+    default: ts.fastKind = kTexGeneric; break;
+    }
+    if (compact && compact->valid)
+    {
+        ts.compactT0 = compact->t0.data();
+        ts.compactBase = compact->Base(ts.tbp0, pixelsPerPage);
+        ts.compactRowPages = (ts.tbw * 64u) / pageW;
+    }
+    else
+    {
+        ts.fastKind = kTexGeneric;
+    }
+}
+
+// Expands the CLUT once into final RGBA32 values (exactly what the old
+// per-texel lookup computed for each index). The table stays valid until the
+// CLUT contents (m_clutVersion), the CLUT format/offset or TEXA change.
+void GSCpuBackend::PrepareClutTable(TextureSetup &ts)
+{
+    ClutTableKey key;
+    key.version = m_clutVersion;
+    key.clutBase = ts.clutBase;
+    key.cpsm = ts.cpsm;
+    key.fourBit = ts.clutFourBitSource;
+    key.csm1EightBit = ts.clutCsm1EightBit;
+    key.sixteenBit = ts.clutSixteenBit;
+    if (ts.cpsm != GS_PSM_CT32) // applyTexa is the identity for CT32
+    {
+        key.ta0 = ts.texa.ta0;
+        key.aem = ts.texa.aem;
+        key.ta1 = ts.texa.ta1;
+    }
+    ts.clutTable = m_clutTable.data();
+    if (key == m_clutTableKey)
+        return;
+    m_clutTableKey = key;
+
+    const uint32_t count = ts.clutFourBitSource ? 16u : 256u;
+    for (uint32_t index = 0; index < count; ++index)
+    {
+        const uint32_t sourceIndex = ts.clutFourBitSource ? (index & 0x0Fu) : index;
+        uint32_t clutIndex = (ts.clutBase + sourceIndex) & (ts.clutSixteenBit ? 0x1FFu : 0x0FFu);
+        if (ts.clutCsm1EightBit)
+        {
+            const uint32_t block = std::min((sourceIndex & 0xF0u) + ts.clutBase, 240u);
+            clutIndex = block + (sourceIndex & 0x0Fu);
+        }
+
+        uint32_t value = 0xFFFF00FFu;
+        switch (ts.cpsm)
+        {
+        case GS_PSM_CT32:
+        {
+            const uint32_t raw = static_cast<uint32_t>(m_clut[clutIndex]) | (static_cast<uint32_t>(m_clut[clutIndex + 256u]) << 16u);
+            value = applyTexa(ts.texa, ts.cpsm, raw);
+            break;
+        }
+        case GS_PSM_CT24:
+        {
+            const uint32_t raw = static_cast<uint32_t>(m_clut[clutIndex]) | (static_cast<uint32_t>(m_clut[clutIndex + 256u]) << 16u);
+            value = applyTexa(ts.texa, ts.cpsm, raw & 0x00FFFFFFu);
+            break;
+        }
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+            value = applyTexa(ts.texa, ts.cpsm, Rgba5551ToRgba8888(m_clut[clutIndex]));
+            break;
+        default:
+            break;
+        }
+        m_clutTable[index] = value;
+    }
+}
+
+void GSCpuBackend::PrepareSetups(const GSDrawState &state, bool needTexture)
+{
+    if (m_setupValid && (!needTexture || (m_setupHasTexture && m_setupClutVersion == m_clutVersion)) &&
+        std::memcmp(&m_setupState, &state, sizeof(GSDrawState)) == 0)
+        return;
+
+    PreparePixelSetup(state, *m_pixelSetup);
+    if (needTexture)
+        PrepareTextureSetup(state, *m_textureSetup);
+    m_setupHasTexture = needTexture;
+    std::memcpy(&m_setupState, &state, sizeof(GSDrawState));
+    m_setupClutVersion = m_clutVersion;
+    m_setupValid = true;
+}
+
+// Typed texel read for already wrapped coordinates: the same swizzle, VRAM
+// wrap and lane extraction as GSMem::ReadTexture, through ResolveDeferred
+// (observably identical to Resolve; see TexturePageCache).
+template <int TexKind>
+GS_FORCEINLINE uint32_t GSCpuBackend::FetchTexel(const TextureSetup &ts, int wrappedU, int wrappedV)
+{
+    const u32 x = static_cast<u32>(wrappedU);
+    const u32 y = static_cast<u32>(wrappedV);
+    GSMem::TexturePageCache &cache = m_texturePageCache;
+    const uint8_t *vram = m_vram;
+    if constexpr (TexKind == kTexC32)
+    {
+        // applyTexa is the identity for CT32.
+        return readTexelCompact<GSMem::C32>(cache, vram, ts.compactT0, ts.compactBase, ts.compactRowPages, x, y);
+    }
+    else if constexpr (TexKind == kTexC24)
+    {
+        return applyTexa(ts.texa, GS_PSM_CT24, readTexelCompact<GSMem::C24>(cache, vram, ts.compactT0, ts.compactBase, ts.compactRowPages, x, y));
+    }
+    else if constexpr (TexKind == kTexP8)
+    {
+        return ts.clutTable[readTexelCompact<GSMem::P8>(cache, vram, ts.compactT0, ts.compactBase, ts.compactRowPages, x, y) & 0xFFu];
+    }
+    else if constexpr (TexKind == kTexP4)
+    {
+        return ts.clutTable[readTexelCompact<GSMem::P4>(cache, vram, ts.compactT0, ts.compactBase, ts.compactRowPages, x, y) & 0x0Fu];
+    }
+    else
+    {
+        using R = TextureSetup::Read;
+        u32 out = 0u;
+        switch (ts.read)
+        {
+        case R::C32: out = readTexelInline<GSMem::C32>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::C24: out = readTexelInline<GSMem::C24>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::C16: out = readTexelInline<GSMem::C16>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::C16S: out = readTexelInline<GSMem::C16S>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::P8: out = readTexelInline<GSMem::P8>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::P4: out = readTexelInline<GSMem::P4>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::P8H: out = readTexelInline<GSMem::P8H>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::P4HL: out = readTexelInline<GSMem::P4HL>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::P4HH: out = readTexelInline<GSMem::P4HH>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::Z32: out = readTexelInline<GSMem::Z32>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::Z24: out = readTexelInline<GSMem::Z24>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::Z16: out = readTexelInline<GSMem::Z16>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        case R::Z16S: out = readTexelInline<GSMem::Z16S>(cache, vram, ts.table, ts.tbp0, ts.tbw, x, y); break;
+        default: break;
+        }
+
+        switch (ts.kind)
+        {
+        case TextureSetup::Kind::Direct:
+            return applyTexa(ts.texa, ts.psm, out);
+        case TextureSetup::Kind::Direct16:
+            return applyTexa(ts.texa, ts.psm, Rgba5551ToRgba8888(static_cast<u16>(out)));
+        case TextureSetup::Kind::Clut:
+        {
+            const uint32_t index = static_cast<u8>(out);
+            return ts.clutTable[ts.clutFourBitSource ? (index & 0x0Fu) : index];
+        }
+        default:
+            break;
+        }
+        return 0xFFFF00FFu;
+    }
+}
+
+template <int TexKind>
+GS_FORCEINLINE uint32_t GSCpuBackend::SampleTexelFast(const TextureSetup &ts, int sampleU, int sampleV)
+{
+    sampleU = wrapTextureCoordinate(sampleU, ts.texW, ts.wrapU, ts.minU, ts.maxU);
+    sampleV = wrapTextureCoordinate(sampleV, ts.texH, ts.wrapV, ts.minV, ts.maxV);
+    return FetchTexel<TexKind>(ts, sampleU, sampleV);
+}
+
+template <int TexKind>
+GS_FORCEINLINE uint32_t GSCpuBackend::SampleTextureFast(const TextureSetup &ts, float s, float t, float q, uint16_t u, uint16_t v)
+{
+    const int texW = ts.texW;
+    const int texH = ts.texH;
+
+    float texUf, texVf;
+    if (ts.fst)
+    {
+        texUf = static_cast<float>(u) / 16.0f;
+        texVf = static_cast<float>(v) / 16.0f;
+    }
+    else
+    {
+        const float invQ = 1.0f / fabsQ(q);
+        texUf = s * invQ * static_cast<float>(texW);
+        texVf = t * invQ * static_cast<float>(texH);
+    }
+
+    if (!ts.linearFilter)
+    {
+        return SampleTexelFast<TexKind>(ts, static_cast<int>(texUf), static_cast<int>(texVf));
+    }
+
+    const float sampleU = texUf - 0.5f;
+    const float sampleV = texVf - 0.5f;
+    const int u0 = static_cast<int>(std::floor(sampleU));
+    const int v0 = static_cast<int>(std::floor(sampleV));
+    const int u1 = u0 + 1;
+    const int v1 = v0 + 1;
+    const float fx = sampleU - static_cast<float>(u0);
+    const float fy = sampleV - static_cast<float>(v0);
+
+    const uint32_t c00 = SampleTexelFast<TexKind>(ts, u0, v0);
+    const uint32_t c10 = SampleTexelFast<TexKind>(ts, u1, v0);
+    const uint32_t c01 = SampleTexelFast<TexKind>(ts, u0, v1);
+    const uint32_t c11 = SampleTexelFast<TexKind>(ts, u1, v1);
+    return bilinearBlend(c00, c10, c01, c11, fx, fy);
+}
+
+// Same semantics as WritePixel, with the primitive-invariant decoding done
+// once in PreparePixelSetup.
+GS_FORCEINLINE void GSCpuBackend::WritePixelFast(const PixelSetup &ps, int x, int y, uint32_t z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog,
+                                                 uint32_t fbAddress, uint32_t zAddress)
+{
+    if (x < ps.scissorX0 || x > ps.scissorX1 || y < ps.scissorY0 || y > ps.scissorY1)
+        return;
+
+    if (ps.fge)
+    {
+        const uint32_t inverseFog = 255u - fog;
+        r = static_cast<uint8_t>(((static_cast<uint32_t>(fog) * r) >> 8) + ((inverseFog * ps.fogR) >> 8));
+        g = static_cast<uint8_t>(((static_cast<uint32_t>(fog) * g) >> 8) + ((inverseFog * ps.fogG) >> 8));
+        b = static_cast<uint8_t>(((static_cast<uint32_t>(fog) * b) >> 8) + ((inverseFog * ps.fogB) >> 8));
+    }
+
+    PixelWriteMask writeMask{};
+    if (ps.alphaTestEnabled)
+    {
+        bool pass;
+        switch (ps.alphaTestMethod)
+        {
+        case 0:
+            pass = false;
+            break;
+        case 1:
+            pass = true;
+            break;
+        case 2:
+            pass = a < ps.alphaRef;
+            break;
+        case 3:
+            pass = a <= ps.alphaRef;
+            break;
+        case 4:
+            pass = a == ps.alphaRef;
+            break;
+        case 5:
+            pass = a >= ps.alphaRef;
+            break;
+        case 6:
+            pass = a > ps.alphaRef;
+            break;
+        case 7:
+            pass = a != ps.alphaRef;
+            break;
+        default:
+            pass = true;
+            break;
+        }
+        if (!pass)
+        {
+            writeMask = ps.alphaFailMask;
+            if (!writeMask.writesAnything())
+                return;
+        }
+    }
+
+    const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha && ps.frameCT32;
+    const bool frmw = ps.destinationAlphaTestNeedsRead ||
+                      (writeMask.writesFramebuffer() && ((ps.fbmsk != 0) || ps.alphaBlendEnabled || preserveDestinationAlpha));
+
+    // fbAddress (CT32/CT24) and zAddress (Z16S/Z32/Z24) come from the caller,
+    // computed with the separable swizzle (identical to swizzledByteAddress).
+    u32 rawFramebufferPixel = 0;
+    u32 fbrgba = 0;
+    if (frmw)
+    {
+        // PSMCT32/24 inlined (identical to GSMem::ReadCT32/ReadCT24).
+        rawFramebufferPixel = ps.frameCT32
+                                  ? load32(m_vram + fbAddress)
+                                  : ps.frameCT24
+                                        ? (load32(m_vram + fbAddress) & 0x00FFFFFFu)
+                                        : ps.readFrame(m_vram, ps.fbp, ps.fbw, x, y);
+        fbrgba = rawFramebufferPixel;
+
+        if (ps.frame16)
+        {
+            fbrgba = Rgba5551ToRgba8888(static_cast<u16>(fbrgba));
+        }
+        else if (ps.frameCT24)
+        {
+            fbrgba |= 0x80000000u;
+        }
+    }
+
+    if (ps.destinationAlphaTest && ps.destinationAlphaBit != 0u)
+    {
+        if ((((rawFramebufferPixel >> ps.destinationAlphaBit) & 0x1u) != 0u) != ps.destinationAlphaMode)
+            return;
+    }
+
+    // ZTST: 0 never, 1 always, 2 GEQUAL, 3 GREATER. The depth read is inline
+    // (a capturing lambda here was not inlined by MSVC and cost a call plus
+    // a closure per pixel).
+    if (ps.ztestMethod >= 2u)
+    {
+        uint32_t depth;
+        if (ps.depthZ16S)
+            depth = load16(m_vram + zAddress);
+        else if (ps.depthZ32) // identical to GSMem::ReadZ32 / ReadZ24
+            depth = ps.depthZ24 ? (load32(m_vram + zAddress) & 0x00FFFFFFu) : load32(m_vram + zAddress);
+        else
+            depth = ps.readDepth(m_vram, ps.zbp, ps.fbw, x, y);
+        if (ps.ztestMethod == 2u ? !(z >= depth) : !(z > depth))
+            return;
+    }
+    else if (ps.ztestMethod == 0u)
+    {
+        return;
+    }
+
+    if (writeMask.writesFramebuffer())
+    {
+        if (ps.alphaBlendEnabled)
+        {
+            if (!(ps.pabe && (a & 0x80u) == 0u))
+            {
+                const uint32_t blended = blendColor(ps, pack32(r, g, b, a), fbrgba);
+                r = static_cast<uint8_t>(blended);
+                g = static_cast<uint8_t>(blended >> 8);
+                b = static_cast<uint8_t>(blended >> 16);
+            }
+        }
+
+        if (writeMask.writeAlpha && ps.forceAlphaMsb)
+        {
+            a = static_cast<uint8_t>(a | 0x80u);
+        }
+
+        u32 pixel = pack32(r, g, b, a);
+
+        if (ps.fbmsk != 0)
+        {
+            pixel = (pixel & ~ps.fbmsk) | (fbrgba & ps.fbmsk);
+        }
+
+        if (preserveDestinationAlpha)
+        {
+            pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+        }
+
+        if (ps.frame16)
+        {
+            pixel = Rgba8888ToRgba5551(pixel);
+        }
+
+        if (ps.frameCT32)
+        {
+            m_texturePageCache.NotifyWrite(m_vram, fbAddress);
+            store32(m_vram + fbAddress, pixel);
+        }
+        else if (ps.frameCT24)
+        {
+            // Identical to GSMem::WriteCT24: keep the stored upper byte.
+            m_texturePageCache.NotifyWrite(m_vram, fbAddress);
+            uint8_t *dst = m_vram + fbAddress;
+            store32(dst, (load32(dst) & 0xFF000000u) | (pixel & 0x00FFFFFFu));
+        }
+        else
+        {
+            m_texturePageCache.Materialize(m_vram);
+            ps.writeFrame(m_vram, ps.fbp, ps.fbw, x, y, pixel);
+        }
+    }
+
+    if (writeMask.writeDepth && !ps.zmask)
+    {
+        if (ps.depthZ16S)
+        {
+            m_texturePageCache.NotifyWrite(m_vram, zAddress);
+            store16(m_vram + zAddress, static_cast<uint16_t>(z));
+        }
+        else if (ps.depthZ32)
+        {
+            // Identical to GSMem::WriteZ32 / WriteZ24 (Z24 keeps the stored upper byte).
+            m_texturePageCache.NotifyWrite(m_vram, zAddress);
+            uint8_t *dst = m_vram + zAddress;
+            store32(dst, ps.depthZ24 ? ((load32(dst) & 0xFF000000u) | (z & 0x00FFFFFFu)) : z);
+        }
+        else
+        {
+            m_texturePageCache.Materialize(m_vram);
+            ps.writeDepth(m_vram, ps.zbp, ps.fbw, x, y, z);
+        }
+    }
+}
+
+// WritePixelFast for PixelSetup::simpleWrite states: every test passes and the
+// write mask is RGBA+Z, so only FBA, FBMSK and the stores remain (same order:
+// frame then Z). Callers guarantee x/y are inside the scissor.
+GS_FORCEINLINE void GSCpuBackend::WritePixelSimple(const PixelSetup &ps, uint32_t z, uint32_t rgba, uint32_t fbAddress, uint32_t zAddress)
+{
+    uint32_t pixel = rgba | ps.alphaOr;
+    if (ps.fbmsk != 0u)
+        pixel = (pixel & ~ps.fbmsk) | (load32(m_vram + fbAddress) & ps.fbmsk);
+    m_texturePageCache.NotifyWrite(m_vram, fbAddress);
+    store32(m_vram + fbAddress, pixel);
+
+    if (!ps.zmask)
+    {
+        m_texturePageCache.NotifyWrite(m_vram, zAddress);
+        uint8_t *dst = m_vram + zAddress;
+        if (ps.depthZ16S)
+            store16(dst, static_cast<uint16_t>(z));
+        else
+            store32(dst, ps.depthZ24 ? ((load32(dst) & 0xFF000000u) | (z & 0x00FFFFFFu)) : z);
+    }
+}
+
+// WritePixelFast for PixelSetup::simpleBlend states (as simpleWrite, plus the
+// blend, which reads the frame).
+GS_FORCEINLINE void GSCpuBackend::WritePixelSimpleBlend(const PixelSetup &ps, uint32_t z, uint32_t rgba, uint32_t fbAddress, uint32_t zAddress)
+{
+    const uint32_t fbrgba = load32(m_vram + fbAddress);
+    uint32_t pixel = rgba;
+    if (!(ps.pabe && (rgba & 0x80000000u) == 0u))
+        pixel = blendColor(ps, rgba, fbrgba);
+    pixel |= ps.alphaOr;
+    if (ps.fbmsk != 0u)
+        pixel = (pixel & ~ps.fbmsk) | (fbrgba & ps.fbmsk);
+    m_texturePageCache.NotifyWrite(m_vram, fbAddress);
+    store32(m_vram + fbAddress, pixel);
+
+    if (!ps.zmask)
+    {
+        m_texturePageCache.NotifyWrite(m_vram, zAddress);
+        uint8_t *dst = m_vram + zAddress;
+        if (ps.depthZ16S)
+            store16(dst, static_cast<uint16_t>(z));
+        else
+            store32(dst, ps.depthZ24 ? ((load32(dst) & 0xFF000000u) | (z & 0x00FFFFFFu)) : z);
+    }
+}
